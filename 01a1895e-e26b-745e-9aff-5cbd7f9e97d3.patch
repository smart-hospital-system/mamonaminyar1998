+    link: { href: "/hms", label: L(lang, "Open command centre", "رفتن به مرکز فرمان") },
+    followups: [
+      { label: L(lang, "What is low on stock?", "چه دوا کم است؟"), q: L(lang, "low stock", "موجودی کم") },
