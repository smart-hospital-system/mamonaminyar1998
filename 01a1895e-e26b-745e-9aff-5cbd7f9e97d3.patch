new file mode 100644
index 0000000..bdb149e
--- /dev/null
+++ b/app/api/hms/prescriptions/[id]/route.ts
@@ -0,0 +1,80 @@
+import { body, json, route } from "@/lib/api";
+import { requireHmsApi } from "@/lib/hms/auth";
+import { getSection, hAudit, hNow, hRun, hGet, hAll, hUid } from "@/lib/hms/db";
+import { getPrescription } from "@/lib/hms/queries";
+
+export const GET = route<{ id: string }>(async (_req, { params }) => {
+  await requireHmsApi();
+  const { id } = await params;
+  const rx = getPrescription(id);
+  if (!rx) return json({ error: "Prescription not found" }, 404);
+  return json({ prescription: rx });
+});
+
+export const PATCH = route<{ id: string }>(async (req, { params }) => {
+  const { id } = await params;
+  const p = await body<{ action?: string; note?: string; template?: number; notes?: string; follow_up?: string }>(req);
+  const rx = getPrescription(id);
+  if (!rx) return json({ error: "Prescription not found" }, 404);
+  const action = p.action ?? "update";
+
+  if (action === "sign") {
+    const user = await requireHmsApi(["admin", "doctor"]);
+    hRun("UPDATE hms_prescriptions SET status = 'signed', signed_by = ?, signed_at = ? WHERE id = ?", [user.id, hNow(), id]);
+    hAudit(user, "signed", "prescription", id, `Signed ${rx.rx_no} for ${rx.patient_name}`);
+    return json({ ok: true, prescription: getPrescription(id) });
+  }
+
+  if (action === "dispense") {
+    const user = await requireHmsApi(["admin", "pharmacist"]);
+    // A prescription is a legal instruction from a physician: nothing leaves the
+    // pharmacy counter until it carries a signature (Settings -> Clinical rules).
+    const clinical = getSection<Record<string, unknown>>("clinical");
+    const flag = clinical.require_signature;
+    if (rx.status === "dispensed") {
+      return json({ error: "This prescription has already been dispensed — handing it over twice would double the charge and the stock movement." }, 409);
+    }
+    if (rx.status === "void") {
+      return json({ error: "This prescription was voided and cannot be dispensed." }, 409);
+    }
+    const mustSign = flag === undefined ? true : ![false, 0, "0", "false", "no"].includes(flag as never);
+    if (mustSign && rx.status !== "signed") {
+      return json(
+        { error: "This prescription is still unsigned — ask the prescribing physician to sign it before dispensing." },
+        409
+      );
+    }
+    const items = rx.items as { drug: string; qty: number; unit_price: number }[];
+    let total = 0;
+    for (const it of items) {
+      total += Number(it.qty) * Number(it.unit_price || 0.2);
+      const med = hGet<{ id: string; stock: number }>("SELECT id, stock FROM hms_medicines WHERE name = ? AND active = 1", [it.drug]);
+      if (med) {
+        hRun("UPDATE hms_medicines SET stock = MAX(0, stock - ?), updated_at = ? WHERE id = ?", [it.qty, hNow(), med.id]);
+      }
+    }
+    hRun("UPDATE hms_prescriptions SET status = 'dispensed', dispensed_at = ?, pharmacist_id = ? WHERE id = ?", [hNow(), user.id, id]);
+    hRun(
+      "INSERT INTO hms_dispenses (id, prescription_id, patient_id, pharmacist_id, items, total, note, created_at) VALUES (?,?,?,?,?,?,?,?)",
+      [hUid("dsp"), id, rx.patient_id, user.id, JSON.stringify(items.map((i) => ({ drug: i.drug, qty: i.qty }))), Math.round(total * 100) / 100, p.note ?? null, hNow()]
+    );
+    hAudit(user, "dispensed", "prescription", id, `Dispensed ${rx.rx_no} — ${items.length} item(s)`);
+    return json({ ok: true, prescription: getPrescription(id), total: Math.round(total * 100) / 100 });
+  }
+
+  if (action === "void") {
+    const user = await requireHmsApi(["admin", "doctor"]);
+    hRun("UPDATE hms_prescriptions SET status = 'void' WHERE id = ?", [id]);
+    hAudit(user, "voided", "prescription", id, `Voided ${rx.rx_no}`);
+    return json({ ok: true });
+  }
+
+  const user = await requireHmsApi(["admin", "doctor"]);
+  if (p.template) hRun("UPDATE hms_prescriptions SET template = ? WHERE id = ?", [p.template, id]);
+  if (p.notes !== undefined) hRun("UPDATE hms_prescriptions SET notes = ? WHERE id = ?", [p.notes, id]);
+  if (p.follow_up !== undefined) hRun("UPDATE hms_prescriptions SET follow_up = ? WHERE id = ?", [p.follow_up, id]);
+  hAudit(user, "updated", "prescription", id, `Updated ${rx.rx_no}`);
+  return json({ ok: true, prescription: getPrescription(id) });
+});
+
+export const dynamic = "force-dynamic";
diff --git a/app/api/hms/prescriptions/route.ts b/app/api/hms/prescriptions/route.ts
new file mode 100644
index 0000000..091d1e8
--- /dev/null
+++ b/app/api/hms/prescriptions/route.ts
@@ -0,0 +1,83 @@
+import { body, json, qp, route } from "@/lib/api";
+import { requireHmsApi } from "@/lib/hms/auth";
+import { hAudit, hNow, hRun, hUid, hGet } from "@/lib/hms/db";
+import { listPrescriptions, getPrescription } from "@/lib/hms/queries";
+import { screenPrescription, type RxLine } from "@/lib/hms/ai";
+
+type ItemInput = {
+  drug: string; strength?: string; form?: string; dosage?: string; frequency?: string;
+  duration?: string; instructions?: string; qty?: number; unit_price?: number;
+};
+
+export const GET = route(async (req) => {
+  await requireHmsApi();
+  const p = qp(req);
+  return json({
+    items: listPrescriptions({
+      q: p.get("q") ?? undefined,
+      status: p.get("status") ?? undefined,
+      patient_id: p.get("patient_id") ?? undefined,
+      limit: p.get("limit") ? Number(p.get("limit")) : undefined,
+    }),
+  });
+});
+
+export const POST = route(async (req) => {
+  const user = await requireHmsApi(["admin", "doctor"]);
+  const p = await body<{
+    patient_id?: string; encounter_id?: string; diagnosis?: string; icd10?: string;
+    notes?: string; follow_up?: string; template?: number; items?: ItemInput[]; sign?: boolean;
+  }>(req);
+  if (!p.patient_id) return json({ error: "Choose a patient first." }, 422);
+  const items = (p.items ?? []).filter((i) => i.drug?.trim());
+  if (!items.length) return json({ error: "Add at least one medicine." }, 422);
+
+  const patient = hGet<{ name: string; allergies: string | null }>("SELECT name, allergies FROM hms_patients WHERE id = ?", [p.patient_id]);
+  if (!patient) return json({ error: "Patient not found." }, 404);
+
+  const safety = screenPrescription(items as RxLine[], patient.allergies);
+  if (safety.verdict === "stop" && !p.sign) {
+    // clinical override is allowed only when explicitly signing with consent
+    return json({ error: "Safety screen blocked this prescription.", safety }, 422);
+  }
+
+  const id = hUid("rx");
+  const seq = Number(hGet<{ c: number }>("SELECT COUNT(*) AS c FROM hms_prescriptions")?.c ?? 0);
+  const year = new Date().getFullYear();
+  const rxNo = `RX-${year}-${1200 + seq + 1}`;
+  const now = hNow();
+
+  hRun(
+    `INSERT INTO hms_prescriptions (id, rx_no, encounter_id, patient_id, doctor_id, diagnosis, icd10, notes, follow_up,
+      template, status, signed_by, signed_at, created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)`,
+    [
+      id, rxNo, p.encounter_id ?? null, p.patient_id, user.id, p.diagnosis ?? null, p.icd10 ?? null,
+      p.notes ?? null, p.follow_up ?? null, Number(p.template ?? 1),
+      p.sign ? "signed" : "pending", p.sign ? user.id : null, p.sign ? now : null, now,
+    ]
+  );
+
+  items.forEach((it, idx) => {
+    hRun(
+      `INSERT INTO hms_rx_items (id, prescription_id, drug, strength, form, dosage, frequency, duration, instructions, qty, unit_price, sort)
+       VALUES (?,?,?,?,?,?,?,?,?,?,?,?)`,
+      [
+        hUid("rxi"), id, it.drug, it.strength ?? null, it.form ?? null, it.dosage ?? null,
+        it.frequency ?? null, it.duration ?? null, it.instructions ?? null,
+        Number(it.qty ?? 10), Number(it.unit_price ?? 0), idx,
+      ]
+    );
+  });
+
+  // keep the encounter in sync when the prescription came from a consult
+  if (p.encounter_id && p.diagnosis) {
+    hRun("UPDATE hms_encounters SET diagnosis = COALESCE(?, diagnosis), icd10 = COALESCE(?, icd10) WHERE id = ?", [
+      p.diagnosis, p.icd10 ?? null, p.encounter_id,
+    ]);
+  }
+
+  hAudit(user, p.sign ? "signed" : "created", "prescription", id, `${p.sign ? "Signed" : "Drafted"} ${rxNo} for ${patient.name}`);
+  return json({ ok: true, id, rx_no: rxNo, safety, prescription: getPrescription(id) }, 201);
+});
+
+export const dynamic = "force-dynamic";
diff --git a/app/api/hms/search/route.ts b/app/api/hms/search/route.ts
new file mode 100644
index 0000000..e09abac
--- /dev/null
+++ b/app/api/hms/search/route.ts
@@ -0,0 +1,147 @@
+import { json, qp, route } from "@/lib/api";
+import { requireHmsApi } from "@/lib/hms/auth";
+import { hAll, hmsReady } from "@/lib/hms/db";
+
+/**
+ * GET /api/hms/search?q=…
+ *
+ * One query, every corner of the hospital. The command palette (⌘K) uses this
+ * so a clerk can type "Ahmad", "RX-1042", "AYB-2026-0148" or "metformin" and
+ * land on the right record in one keystroke, without knowing which screen it
+ * lives on.
+ *
+ * The search is deliberately tolerant: it matches partial words, is case
+ * insensitive, and treats MRN / invoice / prescription numbers as first-class
+ * citizens. Results are grouped and capped so the palette stays instant even
+ * with years of data.
+ */
+
+type Hit = { id: string; title: string; subtitle?: string; kind: string; href: string; meta?: string };
+
+const LIMIT = 5;
+
+export const GET = route(async (req) => {
+  const user = await requireHmsApi();
+  hmsReady();
+  const q = (qp(req).get("q") ?? "").trim();
+  if (q.length < 2) return json({ q, groups: [], total: 0 });
+
+  const like = `%${q.replace(/[%_]/g, "")}%`;
+  const groups: { key: string; items: Hit[] }[] = [];
+  const push = (key: string, items: Hit[]) => {
+    if (items.length) groups.push({ key, items });
+  };
+
+  /* ------------------------------------------------------------- patients */
+  const patients = hAll<{ id: string; mrn: string; name: string; gender: string; dob: string; phone: string }>(
+    `SELECT id, mrn, name, gender, dob, phone FROM hms_patients
+     WHERE name LIKE ? OR mrn LIKE ? OR phone LIKE ? OR id LIKE ?
+     ORDER BY (mrn LIKE ?) DESC, name LIMIT ${LIMIT}`,
+    [like, like, like, like, like]
+  );
+  push(
+    "patients",
+    patients.map((p) => ({
+      id: p.id,
+      title: p.name,
+      subtitle: `${p.mrn} · ${p.gender}${p.dob ? ` · ${p.dob}` : ""}`,
+      meta: p.phone ?? undefined,
+      kind: "patient",
+      href: `/hms/patients/${p.id}`,
+    }))
+  );
+
+  /* -------------------------------------------------------- prescriptions */
+  const rxs = hAll<never>(
+    `SELECT r.id, r.rx_no, r.status, p.name AS patient, r.diagnosis
+       FROM hms_prescriptions r LEFT JOIN hms_patients p ON p.id = r.patient_id
+      WHERE r.rx_no LIKE ? OR p.name LIKE ? OR r.diagnosis LIKE ?
+      ORDER BY r.created_at DESC LIMIT ${LIMIT}`,
+    [like, like, like]
+  ) as { id: string; rx_no: string; status: string; patient: string | null; diagnosis: string | null }[];
+  push(
+    "prescriptions",
+    rxs.map((r) => ({
+      id: r.id,
+      title: r.rx_no,
+      subtitle: [r.patient, r.diagnosis].filter(Boolean).join(" · "),
+      meta: r.status,
+      kind: "prescription",
+      href: `/hms/rx/${r.id}`,
+    }))
+  );
+
+  /* -------------------------------------------------------------- invoices */
+  const invoices = hAll<never>(
+    `SELECT i.id, i.invoice_no, i.status, i.total, p.name AS patient
+       FROM hms_invoices i LEFT JOIN hms_patients p ON p.id = i.patient_id
+      WHERE i.invoice_no LIKE ? OR p.name LIKE ?
+      ORDER BY i.created_at DESC LIMIT ${LIMIT}`,
+    [like, like]
+  ) as { id: string; invoice_no: string; status: string; total: number; patient: string | null }[];
+  push(
+    "invoices",
+    invoices.map((i) => ({
+      id: i.id,
+      title: i.invoice_no,
+      subtitle: i.patient ?? "",
+      meta: `${i.status} · ${i.total}`,
+      kind: "invoice",
+      href: `/hms/receipt/${i.id}`,
+    }))
+  );
+
+  /* ------------------------------------------------------------- medicines */
+  const meds = hAll<never>(
+    `SELECT id, name, strength, form, stock, category FROM hms_medicines
+      WHERE name LIKE ? OR category LIKE ? OR id LIKE ?
+      ORDER BY name LIMIT ${LIMIT}`,
+    [like, like, like]
+  ) as { id: string; name: string; strength: string | null; form: string | null; stock: number; category: string | null }[];
+  push(
+    "medicines",
+    meds.map((m) => ({
+      id: m.id,
+      title: [m.name, m.strength].filter(Boolean).join(" "),
+      subtitle: [m.form, m.category].filter(Boolean).join(" · "),
+      meta: `${m.stock} in stock`,
+      kind: "medicine",
+      href: `/hms/pharmacy?q=${encodeURIComponent(m.name)}`,
+    }))
+  );
+
+  /* ----------------------------------------------------------- lab & imaging */
+  const labs = hAll<{ id: string; test_name: string; status: string; panel: string }>(
+    `SELECT id, test_name, status, panel FROM hms_lab_orders
+      WHERE id LIKE ? OR test_name LIKE ? ORDER BY created_at DESC LIMIT 3`,
+    [like, like]
+  );
+  const imaging = hAll<{ id: string; modality: string; body_part: string; status: string }>(
+    `SELECT id, modality, body_part, status FROM hms_imaging_orders
+      WHERE id LIKE ? OR body_part LIKE ? ORDER BY created_at DESC LIMIT 3`,
+    [like, like]
+  );
+  push(
+    "orders",
+    [
+      ...labs.map((l) => ({ id: l.id, title: l.test_name, subtitle: `Laboratory${l.panel ? ` · ${l.panel}` : ""}`, meta: l.status, kind: "lab", href: "/hms/lab" })),
+      ...imaging.map((i) => ({ id: i.id, title: `${i.modality} · ${i.body_part}`, subtitle: "Radiology", meta: i.status, kind: "imaging", href: "/hms/radiology" })),
+    ]
+  );
+
+  /* ----------------------------------------------------------------- staff */
+  if (["admin", "doctor"].includes(user.role)) {
+    const staff = hAll<never>(
+      `SELECT id, name, email, role, title FROM hms_users WHERE name LIKE ? OR email LIKE ? OR title LIKE ? LIMIT 3`,
+      [like, like, like]
+    ) as { id: string; name: string; email: string; role: string; title: string | null }[];
+    push(
+      "staff",
+      staff.map((s) => ({ id: s.id, title: s.name, subtitle: s.title ?? s.role, meta: s.email, kind: "staff", href: "/hms/team" }))
+    );
+  }
+
+  return json({ q, total: groups.reduce((a, g) => a + g.items.length, 0), groups });
+});
+
+export const dynamic = "force-dynamic";
