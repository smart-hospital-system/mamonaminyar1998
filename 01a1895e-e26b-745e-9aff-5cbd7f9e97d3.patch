+      Number(p.max_uses ?? 100),
+      new Date().toISOString(),
+      p.expires_at ?? null,
+      new Date().toISOString(),
+    ]
+  );
+  logActivity(user, "created", "coupon", id, `Created coupon ${p.code.toUpperCase()}`);
+  return json({ ok: true, id, items: listCoupons() }, 201);
+});
