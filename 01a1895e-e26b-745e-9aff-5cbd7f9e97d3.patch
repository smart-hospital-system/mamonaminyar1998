+      <p className="pb-1 text-center text-[0.6rem]" style={{ color: "var(--hms-faint)" }}>
+        {String(identity.name)} · {String(identity.license_no ?? "")} · {tr("dash.footer", { n: digitsOf(lang, admissions.length) })}
+      </p>
+    </div>
+  );
+}
