+      ins("hms_invoices", {
+        id: `inv_${9001 + i}`, invoice_no: `AYB-2026-${String(3100 + i)}`, patient_id: patient.id,
+        encounter_id: i < 8 ? encounters[i % encounters.length].id : null, items: JSON.stringify(items),
