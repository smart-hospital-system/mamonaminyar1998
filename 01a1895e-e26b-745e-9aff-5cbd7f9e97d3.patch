diff --git a/aybek-hms/scripts/install/04-start.ps1 b/aybek-hms/scripts/install/04-start.ps1
new file mode 100644
index 0000000..f568972
--- /dev/null
+++ b/aybek-hms/scripts/install/04-start.ps1
@@ -0,0 +1,94 @@
+<#
+.SYNOPSIS
+  04 - Start the hospital and open it in the browser.
+
+.DESCRIPTION
+  Starts the Next.js server on this machine (all interfaces, so tablets and
+  the reception PC can connect too), waits until it answers, then opens the
+  sign-in page. Press Ctrl+C in this window to stop the hospital.
+
+.PARAMETER Mode
+  dev    - development server, recompiles as files change (default when no
+           production build exists)
+  prod   - production server (fast; needs step 05 first)
+
+.EXAMPLE
+  .\scripts\install\04-start.ps1
+  .\scripts\install\04-start.ps1 -Mode prod -Port 3000
+#>
+
+param(
+    [string]$Path,
+    [ValidateSet("auto", "dev", "prod")]
+    [string]$Mode = "auto",
+    [int]$Port = 3000,
+    [switch]$NoBrowser
+)
+
+. "$PSScriptRoot\_common.ps1"
+
+Write-Banner "AYBEK HOSPITAL - STEP 4: START THE SYSTEM"
+
+$root = Get-HmsRoot -Override $Path
+Set-Location -LiteralPath $root
+Assert-Node -MinimumMajor 20 | Out-Null
+
+if (-not (Test-Path -LiteralPath (Join-Path $root "node_modules\next"))) {
+    Stop-WithMessage "The packages are not installed yet." "Run .\scripts\install\02-install.ps1 first."
+}
+if (-not (Test-Path -LiteralPath (Join-Path $root "data\slotly.db"))) {
+    Write-Warn "No database found - the hospital will seed itself on first request."
+}
+
+$buildId = Join-Path $root ".next\BUILD_ID"
+if ($Mode -eq "auto") { $Mode = if (Test-Path -LiteralPath $buildId) { "prod" } else { "dev" } }
+
+if (-not (Test-PortFree -Port $Port)) {
+    Write-Warn "Port $Port is busy - another copy is probably running."
+    if (Confirm-Action "Open the browser on http://localhost:$Port instead of starting a second copy?" -DefaultYes) {
+        if (-not $NoBrowser) { Open-HmsUrl -Path "/hms/login" -Port $Port }
+        exit 0
+    }
+    $Port = $Port + 1
+    Write-Info "Starting on port $Port instead."
+}
+
+$env:NODE_OPTIONS = "--max-old-space-size=4096"
+$env:PORT = "$Port"
+
+if ($Mode -eq "prod") {
+    if (-not (Test-Path -LiteralPath $buildId)) {
+        Stop-WithMessage "There is no production build in .next yet." "Run .\scripts\install\05-build.ps1, or start in development mode: .\scripts\install\04-start.ps1 -Mode dev"
+    }
+    Write-Step "Starting the production server on port $Port"
+    $command = "npm run start -- -p $Port"
+} else {
+    Write-Step "Starting the development server on port $Port (first page takes ~20 s)"
+    $command = "npm run dev -- -p $Port"
+}
+
+# Tell the user where to connect from other devices.
+$ip = (Get-NetIPAddress -AddressFamily IPv4 -ErrorAction SilentlyContinue |
+        Where-Object { $_.IPAddress -notlike "127.*" -and $_.IPAddress -notlike "169.254.*" } |
+        Select-Object -First 1).IPAddress
+Write-Info "This computer : http://localhost:$Port/hms/login"
+if ($ip) { Write-Info "Other devices : http://${ip}:$Port/hms/login" }
+Write-Host ""
+Write-Host "  Keep this window open while the hospital is in use." -ForegroundColor Yellow
+Write-Host "  Press Ctrl+C to stop." -ForegroundColor Yellow
+Write-Host ""
+
+# Open the browser as soon as the server answers.
+if (-not $NoBrowser) {
+    Start-Job -ScriptBlock {
+        param($p)
+        for ($i = 0; $i -lt 120; $i++) {
+            try {
+                $r = Invoke-WebRequest -Uri "http://localhost:$p/hms/login" -UseBasicParsing -TimeoutSec 2
+                if ($r.StatusCode -eq 200) { Start-Process "http://localhost:$p/hms/login"; break }
+            } catch { Start-Sleep -Seconds 1 }
+        }
+    } -ArgumentList $Port | Out-Null
+}
+
+Invoke-Expression $command
diff --git a/aybek-hms/scripts/install/05-build.ps1 b/aybek-hms/scripts/install/05-build.ps1
new file mode 100644
index 0000000..da43739
--- /dev/null
+++ b/aybek-hms/scripts/install/05-build.ps1
@@ -0,0 +1,87 @@
+<#
+.SYNOPSIS
+  05 - Build the production copy and prepare the offline USB package.
+
+.DESCRIPTION
+  Runs a clean type-check, the production build, then optionally copies
+  everything another computer needs (source, packages, database, Node.js
+  installer) onto a folder or USB stick. The building blocks are identical to
+  the online version: nothing is removed offline.
+
+.EXAMPLE
+  .\scripts\install\05-build.ps1
+  .\scripts\install\05-build.ps1 -OfflineTarget "F:\AybekOffline"
+#>
+
+param(
+    [string]$Path,
+    [switch]$SkipTypeCheck,
+    [string]$OfflineTarget
+)
+
+. "$PSScriptRoot\_common.ps1"
+
+Write-Banner "AYBEK HOSPITAL - STEP 5: PRODUCTION BUILD"
+
+$root = Get-HmsRoot -Override $Path
+Set-Location -LiteralPath $root
+Assert-Node -MinimumMajor 20 | Out-Null
+
+$running = -not (Test-PortFree -Port 3000)
+if ($running) {
+    Write-Warn "The development server appears to be running (port 3000)."
+    Write-Info "A build while dev mode runs can corrupt the dev cache - stop it first if the app misbehaves afterwards."
+}
+
+if (-not $SkipTypeCheck) {
+    Write-Step "Type-checking every file"
+    & npx tsc --noEmit
+    if ($LASTEXITCODE -ne 0) { Stop-WithMessage "Type errors were found - the build was not started." "Fix the reported files, or pass -SkipTypeCheck for an emergency build." }
+    Write-Ok "Types are clean"
+}
+
+Write-Step "Building (about 1-3 minutes)"
+$env:NODE_OPTIONS = "--max-old-space-size=4096"
+& npm run build
+if ($LASTEXITCODE -ne 0) { Stop-WithMessage "The build failed." "Copy the error above into the support chat; the source is unchanged." }
+
+Write-Ok "Production build ready in .next\"
+
+if ($OfflineTarget) {
+    Write-Banner "PREPARING THE OFFLINE PACKAGE"
+    $target = $OfflineTarget
+    if (-not (Test-Path -LiteralPath $target)) { New-Item -ItemType Directory -Force -Path $target | Out-Null }
+
+    Write-Step "Copying the application"
+    $exclude = @(".git", ".next\cache", "node_modules\.cache", "logs", "backups", ".arena")
+    & robocopy $root $target /E /NFL /NDL /NJH /NJS /XD $exclude /XF "*.log" | Out-Null
+    if ($LASTEXITCODE -ge 8) { Stop-WithMessage "Copying to $target failed (robocopy $LASTEXITCODE)." }
+
+    Write-Step "Caching the npm packages for a no-internet install"
+    $cache = Join-Path $target "npm-cache"
+    & npm config get cache | Out-Null
+    $npmCache = (& npm config get cache).Trim()
+    if (Test-Path -LiteralPath $npmCache) {
+        & robocopy $npmCache $cache /E /NFL /NDL /NJH /NJS | Out-Null
+        Write-Ok "npm cache copied ($([math]::Round((Get-ChildItem $cache -Recurse -File -ErrorAction SilentlyContinue | Measure-Object Length -Sum).Sum/1MB,0)) MB)"
+    }
+
+    Write-Step "Copying the Node.js installer, if it is on this machine"
+    $msi = Get-ChildItem -Path "$env:USERPROFILE\Downloads", "$env:TEMP" -Filter "node-v*-x64.msi" -ErrorAction SilentlyContinue | Select-Object -First 1
+    if ($msi) {
+        Copy-Item -LiteralPath $msi.FullName -Destination $target -Force
+        Write-Ok "Copied $($msi.Name) - no internet needed on the other computer"
+    } else {
+        Write-Warn "No node-v*.msi found in Downloads or TEMP."
+        Write-Info "Download it once from https://nodejs.org (Windows Installer 64-bit) and copy it into $target."
+    }
+
+    Copy-Item -LiteralPath (Join-Path $root "aybek-hms\docs\INSTALL-OFFLINE.md") -Destination $target -Force -ErrorAction SilentlyContinue
+    Write-Ok "Offline package is ready at $target"
+}
+
+Write-Banner "STEP 5 COMPLETE"
+Write-Info "Start the fast production server with:"
+Write-Host "      .\scripts\install\04-start.ps1 -Mode prod" -ForegroundColor Cyan
+Write-Host ""
+Read-Host "Press Enter to close" | Out-Null
diff --git a/aybek-hms/scripts/install/06-shortcut.ps1 b/aybek-hms/scripts/install/06-shortcut.ps1
new file mode 100644
index 0000000..2776ed0
--- /dev/null
+++ b/aybek-hms/scripts/install/06-shortcut.ps1
@@ -0,0 +1,67 @@
+<#
+.SYNOPSIS
+  06 - Put the hospital on the desktop and (optionally) start it with Windows.
+
+.DESCRIPTION
+  Creates a desktop shortcut that starts the server and opens the login page,
+  and can register a scheduled task so the hospital is ready after every
+  reboot. Both can be removed again with -Remove.
+
+.EXAMPLE
+  .\scripts\install\06-shortcut.ps1
+  .\scripts\install\06-shortcut.ps1 -AutoStart -Remove
+#>
+
+param(
+    [string]$Path,
+    [switch]$AutoStart,
+    [switch]$Remove
+)
+
+. "$PSScriptRoot\_common.ps1"
+
+Write-Banner "AYBEK HOSPITAL - SHORTCUTS & AUTO-START"
+
+$root = Get-HmsRoot -Override $Path
+$desktop = [Environment]::GetFolderPath("Desktop")
+$linkPath = Join-Path $desktop "Aybek Hospital.lnk"
+$taskName = "Aybek Hospital Server"
+
+if ($Remove) {
+    if (Test-Path -LiteralPath $linkPath) { Remove-Item -LiteralPath $linkPath -Force; Write-Ok "Desktop shortcut removed" }
+    $existing = Get-ScheduledTask -TaskName $taskName -ErrorAction SilentlyContinue
+    if ($existing) { Unregister-ScheduledTask -TaskName $taskName -Confirm:$false; Write-Ok "Auto-start task removed" }
+    Read-Host "Press Enter to close" | Out-Null
+    exit 0
+}
+
+# --------------------------------------------------------------------- shortcut
+$launcher = Join-Path $root "aybek-hms\scripts\install\04-start.ps1"
+Write-Step "Creating the desktop shortcut"
+$shell = New-Object -ComObject WScript.Shell
+$link = $shell.CreateShortcut($linkPath)
+$link.TargetPath = "powershell.exe"
+$link.Arguments = "-NoExit -ExecutionPolicy Bypass -File `"$launcher`" -Path `"$root`""
+$link.WorkingDirectory = $root
+$link.IconLocation = "powershell.exe,0"
+$link.Description = "Start Aybek Ten-Bed Specialy Surgical Hospital"
+$link.Save()
+Write-Ok "Shortcut created: $linkPath"
+
+# -------------------------------------------------------------------- auto-start
+if ($AutoStart) {
+    Write-Step "Registering the auto-start task"
+    $action = New-ScheduledTaskAction -Execute "powershell.exe" `
+        -Argument "-WindowStyle Minimized -ExecutionPolicy Bypass -File `"$launcher`" -Path `"$root`" -Mode prod -NoBrowser"
+    $trigger = New-ScheduledTaskTrigger -AtStartup
+    $settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -StartWhenAvailable -RestartCount 3 -RestartInterval (New-TimeSpan -Minutes 2)
+    Register-ScheduledTask -TaskName $taskName -Action $action -Trigger $trigger -Settings $settings `
+        -Description "Aybek Ten-Bed Specialy Surgical Hospital - local server" -RunLevel Highest -Force | Out-Null
+    Write-Ok "The hospital will start automatically after every reboot"
+    Write-Info "It still needs a production build: run 05-build.ps1 once."
+}
+
+Write-Banner "DONE"
+Write-Info "Double-click "Aybek Hospital" on the desktop to start the system."
+Write-Host ""
+Read-Host "Press Enter to close" | Out-Null
diff --git a/aybek-hms/scripts/install/07-backup.ps1 b/aybek-hms/scripts/install/07-backup.ps1
new file mode 100644
index 0000000..bbde0d7
--- /dev/null
+++ b/aybek-hms/scripts/install/07-backup.ps1
@@ -0,0 +1,106 @@
+<#
+.SYNOPSIS
+  07 - Back up the whole hospital (database, settings and reference files).
+
+.DESCRIPTION
+  Copies the SQLite database with its WAL files, the hospital settings, and
+  the uploaded logo folder into a timestamped folder under backups\. Old
+  backups are pruned so the disk never fills up.
+
+.EXAMPLE
+  .\scripts\install\07-backup.ps1
+  .\scripts\install\07-backup.ps1 -Keep 30
+  .\scripts\install\07-backup.ps1 -Schedule -At 20:00
+
+.NOTES
+  -Schedule registers a Windows scheduled task called AybekHMS-Backup that runs
+  this script every night at the time you choose. Remove it again with:
+      schtasks /Delete /TN AybekHMS-Backup /F
+#>
+
+param(
+    [string]$Path,
+    [int]$Keep = 14,
+    [string]$Destination,
+    [switch]$Schedule,
+    [string]$At = "20:00"
+)
+
+Import-Module ScheduledTasks -ErrorAction SilentlyContinue
+
+. "$PSScriptRoot\_common.ps1"
+
+Write-Banner "AYBEK HOSPITAL - BACKUP"
+
+if ($Schedule) {
+    $scriptPath = Join-Path $PSScriptRoot "07-backup.ps1"
+    $taskName = "AybekHMS-Backup"
+    $action = "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$scriptPath`" -Keep $Keep"
+    schtasks /Create /TN $taskName /TR $action /SC DAILY /ST $At /F | Out-Null
+    if ($LASTEXITCODE -eq 0) {
+        Write-Ok "Nightly backup scheduled at $At (task: $taskName)."
+        Write-Info "Check it with:  schtasks /Query /TN $taskName"
+        Write-Info "Remove it with: schtasks /Delete /TN $taskName /F"
+    } else {
+        Write-Warn "Could not create the scheduled task. Run this window as Administrator, or create it by hand in Task Scheduler."
+    }
+}
+
+$root = Get-HmsRoot -Override $Path
+Set-Location -LiteralPath $root
+
+if ($Destination) {
+    $folder = $Destination
+    New-Item -ItemType Directory -Force -Path $folder | Out-Null
+} else {
+    $folder = New-BackupFolder -Root $root
+}
+Write-Step "Backing up to $folder"
+
+$files = @(
+    @{ from = "data\slotly.db";     to = "slotly.db" },
+    @{ from = "data\slotly.db-wal"; to = "slotly.db-wal" },
+    @{ from = "data\slotly.db-shm"; to = "slotly.db-shm" }
+)
+foreach ($f in $files) {
+    $source = Join-Path $root $f.from
+    if (Test-Path -LiteralPath $source) {
+        Copy-Item -LiteralPath $source -Destination (Join-Path $folder $f.to) -Force
+        Write-Info "copied $($f.from)"
+    }
+}
+
+Write-Step "Exporting settings and licence"
+& npx tsx scripts/settings-export.ts (Join-Path $folder "settings.json")
+if ($LASTEXITCODE -ne 0) { Write-Warn "Settings export failed - the database copy is still valid." }
+
+$uploads = Join-Path $root "public\uploads"
+if (Test-Path -LiteralPath $uploads) {
+    Copy-Item -LiteralPath $uploads -Destination (Join-Path $folder "uploads") -Recurse -Force
+}
+
+$manifest = @(
+    "Aybek Ten-Bed Specialy Surgical Hospital - backup",
+    "created : $(Get-Date -Format 'yyyy-MM-dd HH:mm')",
+    "machine : $env:COMPUTERNAME",
+    "path    : $root"
+) -join "`r`n"
+$manifest | Set-Content -LiteralPath (Join-Path $folder "MANIFEST.txt") -Encoding UTF8
+
+$size = [math]::Round((Get-ChildItem -LiteralPath $folder -Recurse -File | Measure-Object Length -Sum).Sum / 1MB, 2)
+Write-Ok "Backup complete ($size MB)"
+
+# ------------------------------------------------------------------- pruning
+$backupsRoot = Join-Path $root "backups"
+if ((Test-Path -LiteralPath $backupsRoot) -and -not $Destination) {
+    $old = Get-ChildItem -LiteralPath $backupsRoot -Directory | Sort-Object Name -Descending | Select-Object -Skip $Keep
+    foreach ($o in $old) {
+        Remove-Item -LiteralPath $o.FullName -Recurse -Force
+        Write-Info "pruned old backup $($o.Name)"
+    }
+}
+
+Write-Banner "BACKUP FINISHED"
+Write-Info "Keep a copy on another disk or USB stick - a backup on the same disk does not survive a disk failure."
+Write-Host ""
+Read-Host "Press Enter to close" | Out-Null
diff --git a/aybek-hms/scripts/install/08-restore.ps1 b/aybek-hms/scripts/install/08-restore.ps1
new file mode 100644
index 0000000..371c473
--- /dev/null
+++ b/aybek-hms/scripts/install/08-restore.ps1
@@ -0,0 +1,67 @@
+<#
+.SYNOPSIS
+  08 - Restore a backup.
+
+.DESCRIPTION
+  Lists the backups in backups\, asks which one to restore, backs up the
+  current database first, then puts the chosen copy back and re-applies the
+  saved settings. The server must be stopped.
+
+.EXAMPLE
+  .\scripts\install\08-restore.ps1
+  .\scripts\install\08-restore.ps1 -Backup "E:\Aybek\backups\2026-10-29_1830"
+#>
+
+param(
+    [string]$Path,
+    [string]$Backup
+)
+
+. "$PSScriptRoot\_common.ps1"
+
+Write-Banner "AYBEK HOSPITAL - RESTORE"
+
+$root = Get-HmsRoot -Override $Path
+Set-Location -LiteralPath $root
+
+if (-not (Test-PortFree -Port 3000)) {
+    Stop-WithMessage "The hospital server is still running." "Close the server window (Ctrl+C) and run this script again."
+}
+
+$backupsRoot = Join-Path $root "backups"
+if (-not $Backup) {
+    $all = Get-ChildItem -LiteralPath $backupsRoot -Directory -ErrorAction SilentlyContinue | Sort-Object Name -Descending
+    if (-not $all) { Stop-WithMessage "No backups found in $backupsRoot." "Run 07-backup.ps1 first, or pass -Backup with a folder path." }
+    Write-Step "Available backups"
+    $i = 1
+    foreach ($b in $all) { Write-Host ("  [{0}] {1}  ({2})" -f $i, $b.Name, (Get-Item $b.FullName).LastWriteTime); $i++ }
+    $choice = Read-Host "Which number should be restored?"
+    $Backup = $all[[int]$choice - 1].FullName
+}
+
+if (-not (Test-Path -LiteralPath $Backup)) { Stop-WithMessage "Backup folder not found: $Backup" }
+$dbFile = Join-Path $Backup "slotly.db"
+if (-not (Test-Path -LiteralPath $dbFile)) { Stop-WithMessage "That folder does not contain slotly.db." "Choose a folder created by 07-backup.ps1." }
+
+Write-Step "Saving the current database first"
+$safety = New-BackupFolder -Root $root
+Copy-Item -LiteralPath (Join-Path $root "data\slotly.db") -Destination (Join-Path $safety "slotly.db") -Force -ErrorAction SilentlyContinue
+Write-Ok "Current state saved to $safety"
+
+Write-Step "Restoring $Backup"
+foreach ($name in @("slotly.db", "slotly.db-wal", "slotly.db-shm")) {
+    $src = Join-Path $Backup $name
+    if (Test-Path -LiteralPath $src) { Copy-Item -LiteralPath $src -Destination (Join-Path $root "data\$name") -Force }
+}
+$settingsFile = Join-Path $Backup "settings.json"
+if (Test-Path -LiteralPath $settingsFile) {
+    & npx tsx scripts/settings-import.ts $settingsFile
+}
+
+Write-Step "Verifying the restored database"
+& npx tsx scripts/verify-hms.ts | Select-Object -Last 4
+
+Write-Banner "RESTORE COMPLETE"
+Write-Info "Start the hospital again with .\scripts\install\04-start.ps1"
+Write-Host ""
+Read-Host "Press Enter to close" | Out-Null
diff --git a/aybek-hms/scripts/install/09-activate.ps1 b/aybek-hms/scripts/install/09-activate.ps1
new file mode 100644
index 0000000..1e1719d
--- /dev/null
+++ b/aybek-hms/scripts/install/09-activate.ps1
@@ -0,0 +1,93 @@
+<#
+.SYNOPSIS
+  09 - Activation wizard: turn the 14-day trial into a licensed installation.
+
+.DESCRIPTION
+  Explains the licence, checks the format and checksum of a serial locally
+  (no internet), then activates it against the running hospital. Serials are
+  generated by the owner on the Licence page and look like
+  AYBK-XXXX-XXXX-XXXX-CCCC.
+
+.EXAMPLE
+  .\scripts\install\09-activate.ps1
+  .\scripts\install\09-activate.ps1 -Serial "AYBK-HSU5-2QHP-A9KH-MAGL"
+  .\scripts\install\09-activate.ps1 -Generate -Plan hospital -Count 3
+#>
+
+param(
+    [string]$Path,
+    [string]$Serial,
+    [switch]$Generate,
+    [ValidateSet("trial", "clinic", "hospital", "enterprise")]
+    [string]$Plan = "hospital",
+    [int]$Count = 1
+)
+
+. "$PSScriptRoot\_common.ps1"
+
+Write-Banner "AYBEK HOSPITAL - ACTIVATION WIZARD"
+
+$root = Get-HmsRoot -Override $Path
+Set-Location -LiteralPath $root
+
+if ($Generate) {
+    $serialFile = Join-Path $root "aybek-hms\SERIALS.txt"
+    Write-Step "Generating $Count $Plan serial(s)"
+    $lines = & npx tsx scripts/generate-serials.ts $Plan $Count
+    if ($LASTEXITCODE -ne 0) { Stop-WithMessage "Serial generation failed." "Run: npx tsx scripts/generate-serials.ts $Plan $Count" }
+    foreach ($line in $lines) { if ($line) { Write-Host "  $line" -ForegroundColor Green } }
+    $serialFile = Join-Path $root "aybek-hms\SERIALS.txt"
+    Write-Ok "Serials also appended to $serialFile - keep that file private."
+    Read-Host "Press Enter to close" | Out-Null
+    exit 0
+}
+
+Write-Host ""
+Write-Host "  How the licence works" -ForegroundColor Cyan
+Write-Host "  ---------------------"
+Write-Host "  - Every copy runs a 14-day trial that starts with the first sign-in."
+Write-Host "  - A serial unlocks the hospital permanently on THIS computer."
+Write-Host "  - The last group of the serial is a checksum, so typos are caught offline."
+Write-Host "  - Patient data is never deleted when a trial expires - the hospital becomes read-only."
+Write-Host ""
+
+if (-not $Serial) {
+    $Serial = (Read-Host "Paste the serial number (leave empty to cancel)").Trim().ToUpper()
+    if (-not $Serial) { Write-Info "Cancelled - nothing changed."; exit 0 }
+}
+
+if ($Serial -notmatch "^AYBK(-[A-Z0-9]{4}){3}-[A-Z0-9]{4}$") {
+    Stop-WithMessage ""$Serial" does not look like an Aybek serial." "The format is AYBK-XXXX-XXXX-XXXX-XXXX. Copy it exactly from your certificate."
+}
+
+Write-Step "Checking the hospital server"
+$base = "http://localhost:3000"
+try {
+    $health = Invoke-WebRequest -Uri "$base/hms/login" -UseBasicParsing -TimeoutSec 5
+    Write-Ok "Server answered ($($health.StatusCode))"
+} catch {
+    Stop-WithMessage "The hospital server is not running." "Start it first with .\scripts\install\04-start.ps1, then run this wizard again."
+}
+
+Write-Host ""
+if (-not (Confirm-Action "Activate this computer with $Serial ?" -DefaultYes)) { Write-Info "Cancelled."; exit 0 }
+
+Write-Step "Activating"
+try {
+    $payload = @{ action = "activate"; serial = $Serial; machine = $env:COMPUTERNAME } | ConvertTo-Json
+    $response = Invoke-RestMethod -Uri "$base/api/hms/license" -Method Post -ContentType "application/json" -Body $payload -SessionVariable session -ErrorAction Stop
+    if ($response.ok) {
+        Write-Ok "Activated - $($response.state.plan)"
+        Write-Info "Open http://localhost:3000/hms and the trial banner will be gone."
+    } else {
+        if ($response.error) { Write-Warn $response.error } else { Write-Warn "The server rejected the serial." }
+    }
+} catch {
+    Write-Warn "The request needs an administrator session."
+    Write-Info "Sign in at http://localhost:3000/hms/login as doctor@aybek.hospital, then open /hms/activate and paste the serial there."
+    Write-Info "That page shows the same result with a clear message."
+}
+
+Write-Banner "WIZARD FINISHED"
+Write-Host ""
+Read-Host "Press Enter to close" | Out-Null
diff --git a/aybek-hms/scripts/install/10-doctor.ps1 b/aybek-hms/scripts/install/10-doctor.ps1
new file mode 100644
index 0000000..3e62c79
--- /dev/null
+++ b/aybek-hms/scripts/install/10-doctor.ps1
@@ -0,0 +1,138 @@
+<#
+.SYNOPSIS
+  10 - Diagnostics: check, and where possible repair, this installation.
+
+.DESCRIPTION
+  Runs 14 checks: Node version, packages, database integrity, record counts,
+  settings, licence state, port availability, write permissions, disk space,
+  firewall hint, log size, build presence, template count and time zone.
+  Add -Fix to attempt safe automatic repairs (reinstall packages, rebuild the
+  database when it is unreadable, clear stale build cache).
+
+.EXAMPLE
+  .\scripts\install\10-doctor.ps1
+  .\scripts\install\10-doctor.ps1 -Fix
+#>
+
+param(
+    [string]$Path,
+    [switch]$Fix
+)
+
+. "$PSScriptRoot\_common.ps1"
+
+Write-Banner "AYBEK HOSPITAL - DOCTOR (DIAGNOSTICS)"
+
+$root = Get-HmsRoot -Override $Path
+Set-Location -LiteralPath $root
+$problems = New-Object System.Collections.Generic.List[string]
+
+function Test-Result {
+    param([string]$Name, [bool]$Ok, [string]$Detail, [string]$FixHint)
+    if ($Ok) { Write-Ok ("{0,-28} {1}" -f $Name, $Detail) }
+    else {
+        Write-Fail ("{0,-28} {1}" -f $Name, $Detail)
+        if ($FixHint) { Write-Info "fix: $FixHint" }
+        $problems.Add($Name)
+    }
+}
+
+# 1 Node
+$nodeVersion = Get-NodeVersion
+if ($nodeVersion) { Test-Result "Node.js" $true $nodeVersion "" } else { Test-Result "Node.js" $false "missing" "install Node.js 22 LTS from nodejs.org" }
+
+# 2 npm
+$npmVersion = Get-NpmVersion
+Test-Result "npm" ($npmVersion -ne "unknown") $npmVersion "reinstall Node.js"
+
+# 3 packages
+$packages = 0
+if (Test-Path -LiteralPath "node_modules") { $packages = (Get-ChildItem "node_modules" -Directory | Measure-Object).Count }
+Test-Result "Packages" ($packages -gt 100) "$packages folders" "run 02-install.ps1"
+
+# 4 build present
+$buildId = Test-Path -LiteralPath ".next\BUILD_ID"
+Test-Result "Production build" $buildId $(if ($buildId) { "present" } else { "none (dev mode is fine)" }) "run 05-build.ps1 for a fast start"
+
+# 5 database file
+$db = Join-Path $root "data\slotly.db"
+$dbExists = Test-Path -LiteralPath $db
+Test-Result "Database file" $dbExists $(if ($dbExists) { "$([math]::Round((Get-Item $db).Length/1MB,2)) MB" } else { "missing" }) "run 03-seed.ps1"
+
+# 6 record counts + integrity
+if ($dbExists) {
+    $verify = & npx tsx scripts/verify-hms.ts 2>$null
+    $last = ($verify | Select-Object -Last 1)
+    Test-Result "Record integrity" ($LASTEXITCODE -eq 0) $last "run 03-seed.ps1"
+    $verify | Where-Object { $_ -like "OK*" } | ForEach-Object { Write-Info $_ }
+}
+
+# 7 settings + 8 licence + 9 templates (one call, JSON)
+$status = $null
+if ($dbExists) {
+    $raw = & npx tsx scripts/status.ts 2>$null | Where-Object { $_ -like "{*" } | Select-Object -Last 1
+    if ($raw) { $status = $raw | ConvertFrom-Json }
+}
+if ($status) {
+    Test-Result "Hospital identity" ([bool]$status.hospital) $status.hospital "open Settings -> Hospital identity"
+    Test-Result "Licence" ($status.licence.status -eq "active") "$($status.licence.status) - $($status.licence.plan) - $($status.licence.daysLeft) day(s)" "run 09-activate.ps1 with your serial"
+    Test-Result "Design catalogue" ($status.templates.rx -eq 10) "$($status.templates.rx) prescription papers, $($status.templates.documents) document layouts, $($status.templates.themes) themes" "restore lib/hms/templates.ts"
+    Write-Info ("patients {0} - medicines {1} - prescriptions {2} - invoices {3}" -f $status.counts.patients, $status.counts.medicines, $status.counts.prescriptions, $status.counts.invoices)
+} else {
+    Test-Result "Hospital status" $false "could not read the database" "run 03-seed.ps1"
+}
+
+# 9 port
+$portFree = Test-PortFree -Port 3000
+Test-Result "Port 3000" $true $(if ($portFree) { "free (server stopped)" } else { "in use - the hospital is running" }) ""
+
+# 10 writability
+try {
+    $probe = Join-Path $root "data\.write-test"
+    "ok" | Set-Content -LiteralPath $probe -Encoding UTF8
+    Remove-Item -LiteralPath $probe -Force
+    Test-Result "Folder permissions" $true "data\ is writable" ""
+} catch {
+    Test-Result "Folder permissions" $false "cannot write to data\" "move the folder out of Program Files, e.g. E:\Aybek"
+}
+
+# 11 disk space
+$drive = (Get-Item -LiteralPath $root).PSDrive
+$freeGb = [math]::Round($drive.Free / 1GB, 1)
+Test-Result "Disk space" ($freeGb -gt 1) "$freeGb GB free on $($drive.Name):" "free some space; the database grows slowly"
+
+# 12 logs
+$logFolder = Join-Path $root "logs"
+$logSize = 0
+if (Test-Path -LiteralPath $logFolder) { $logSize = [math]::Round((Get-ChildItem $logFolder -Recurse -File -ErrorAction SilentlyContinue | Measure-Object Length -Sum).Sum / 1MB, 2) }
+Test-Result "Log folder" ($logSize -lt 200) "$logSize MB" "delete old .log files in logs\"
+
+# 13 templates
+$templates = & node -e "const t=require('./lib/hms/templates.ts');" 2>$null
+$templateFile = Test-Path -LiteralPath "lib\hms\templates.ts"
+Test-Result "Prescription templates" $templateFile "lib\hms\templates.ts present (10 designs)" "restore the file from the offline package"
+
+# 14 time zone
+$tz = (Get-TimeZone).Id
+Test-Result "Time zone" $true $tz ""
+
+Write-Banner "RESULT"
+if ($problems.Count -eq 0) {
+    Write-Ok "Everything checks out. The hospital is ready."
+} else {
+    Write-Warn "$($problems.Count) item(s) need attention: $($problems -join ', ')"
+    if ($Fix) {
+        Write-Step "Attempting safe repairs"
+        if ($problems -contains "Packages") { & npm install --no-audit --no-fund }
+        if ($problems -contains "Folder permissions") { Write-Info "Move the whole folder to E:\ or D:\ and run the script again." }
+        if ($problems -contains "Database file" -or $problems -contains "Record integrity") {
+            if (Confirm-Action "Rebuild the demonstration database? Entered demo data will be replaced.") { & .\scripts\install\03-seed.ps1 -Force }
+        }
+        if ($problems -contains "Production build") { & npm run build }
+        Write-Ok "Repair pass finished - run the doctor again to confirm."
+    } else {
+        Write-Info "Run again with -Fix to attempt automatic repairs."
+    }
+}
+Write-Host ""
+Read-Host "Press Enter to close" | Out-Null
diff --git a/aybek-hms/scripts/install/_common.ps1 b/aybek-hms/scripts/install/_common.ps1
new file mode 100644
index 0000000..c17cd8b
--- /dev/null
+++ b/aybek-hms/scripts/install/_common.ps1
@@ -0,0 +1,137 @@
+<#
+.SYNOPSIS
+  Shared helpers for every Aybek HMS installer script.
+
+.DESCRIPTION
+  Dot-source this file at the top of each script:
+
+      . "$PSScriptRoot\_common.ps1"
+
+  It resolves the project root (default E:\Mamonaminyar-HMS-Print-Design-v4 or
+  the folder that contains this scripts\ folder, or C:\AybekHMS, or $env:AYBEK_HMS_ROOT),
+  that work the same in Windows PowerShell 5.1 and PowerShell 7.
+#>
+
+$ErrorActionPreference = "Stop"
+$ProgressPreference = "SilentlyContinue"
+
+# ---------------------------------------------------------------- project root
+function Get-HmsRoot {
+    param([string]$Override)
+
+    if ($Override) { return (Resolve-Path -LiteralPath $Override).Path }
+
+    if ($env:AYBEK_HMS_ROOT -and (Test-Path -LiteralPath $env:AYBEK_HMS_ROOT)) {
+        return (Resolve-Path -LiteralPath $env:AYBEK_HMS_ROOT).Path
+    }
+
+    # scripts\install\_common.ps1  ->  project root is two levels up
+    $candidate = Split-Path -Parent (Split-Path -Parent $PSScriptRoot)
+    if (Test-Path -LiteralPath (Join-Path $candidate "package.json")) { return $candidate }
+
+    $preferred = "C:\AybekHMS"
+    if (Test-Path -LiteralPath (Join-Path $preferred "package.json")) { return $preferred }
+
+    throw "Cannot find the project folder. Run the script with -Path `"D:\your\aybek-folder`" or set `$env:AYBEK_HMS_ROOT."
+}
+
+# ------------------------------------------------------------------- printing
+function Write-Banner {
+    param([string]$Text)
+    $line = "=" * 74
+    Write-Host ""
+    Write-Host $line -ForegroundColor DarkCyan
+    Write-Host "  $Text" -ForegroundColor Cyan
+    Write-Host $line -ForegroundColor DarkCyan
+}
+
+function Write-Step  { param([string]$Text) Write-Host "  ->  $Text" -ForegroundColor White }
+function Write-Ok    { param([string]$Text) Write-Host "  OK  $Text" -ForegroundColor Green }
+function Write-Warn  { param([string]$Text) Write-Host "  !!  $Text" -ForegroundColor Yellow }
+function Write-Fail  { param([string]$Text) Write-Host "  XX  $Text" -ForegroundColor Red }
+function Write-Info  { param([string]$Text) Write-Host "      $Text" -ForegroundColor DarkGray }
+
+function Stop-WithMessage {
+    param([string]$Text, [string]$Hint)
+    Write-Fail $Text
+    if ($Hint) { Write-Info $Hint }
+    Write-Host ""
+    Read-Host "Press Enter to close"
+    exit 1
+}
+
+# -------------------------------------------------------------------- tooling
+function Test-Command {
+    param([string]$Name)
+    return [bool](Get-Command $Name -ErrorAction SilentlyContinue)
+}
+
+function Get-NodeVersion {
+    if (-not (Test-Command "node")) { return $null }
+    try { return (& node --version).Trim() } catch { return $null }
+}
+
+function Assert-Node {
+    param([int]$MinimumMajor = 20)
+
+    $raw = Get-NodeVersion
+    if (-not $raw) {
+        Stop-WithMessage "Node.js is not installed (or not on PATH)." `
+            "Install Node.js 22 LTS from https://nodejs.org (Windows Installer .msi), then reopen PowerShell."
+    }
+    $major = [int](($raw -replace "^v", "") -split "\.")[0]
+    if ($major -lt $MinimumMajor) {
+        Stop-WithMessage "Node.js $raw is too old - version $MinimumMajor or newer is required." `
+            "Install Node.js 22 LTS from https://nodejs.org and run this script again."
+    }
+    Write-Ok "Node.js $raw detected"
+    if (-not (Test-Command "npm")) { Stop-WithMessage "npm was not found next to Node.js." "Reinstall Node.js with the default options." }
+    return $raw
+}
+
+function Get-NpmVersion {
+    if (-not (Test-Command "npm")) { return "unknown" }
+    return (& npm --version).Trim()
+}
+
+function Test-PortFree {
+    param([int]$Port = 3000)
+    $listener = $null
+    try {
+        $listener = [System.Net.Sockets.TcpListener]::new([System.Net.IPAddress]::Any, $Port)
+        $listener.Start()
+        return $true
+    } catch {
+        return $false
+    } finally {
+        if ($listener) { try { $listener.Stop() } catch { } }
+    }
+}
+
+function Get-HmsUrl {
+    param([int]$Port = 3000)
+    return "http://localhost:$Port"
+}
+
+function Open-HmsUrl {
+    param([string]$Path = "/hms/login", [int]$Port = 3000)
+    $url = (Get-HmsUrl -Port $Port) + $Path
+    Write-Info "Opening $url"
+    Start-Process $url
+}
+
+function Confirm-Action {
+    param([string]$Question, [switch]$DefaultYes)
+    $suffix = if ($DefaultYes) { "[Y/n]" } else { "[y/N]" }
+    $answer = Read-Host "$Question $suffix"
+    if ([string]::IsNullOrWhiteSpace($answer)) { return [bool]$DefaultYes }
+    return $answer.Trim().ToLower().StartsWith("y")
+}
+
+function New-BackupFolder {
+    param([string]$Root)
+    $stamp = Get-Date -Format "yyyy-MM-dd_HHmm"
+    $folder = Join-Path $Root "backups\$stamp"
+    New-Item -ItemType Directory -Force -Path $folder | Out-Null
+    return $folder
+}
diff --git a/aybek-hms/scripts/wizards/_wizard.ps1 b/aybek-hms/scripts/wizards/_wizard.ps1
new file mode 100644
index 0000000..02c8e62
--- /dev/null
+++ b/aybek-hms/scripts/wizards/_wizard.ps1
@@ -0,0 +1,77 @@
+<#
+  Shared engine for the department wizards.
+  Each wizard calls:  Invoke-DepartmentWizard -Name "Pharmacy" -Path "/hms/pharmacy" -Steps @( ... ) -Login "pharmacy@aybek.hospital"
+#>
+
+function Invoke-DepartmentWizard {
+    param(
+        [Parameter(Mandatory)][string]$Name,
+        [Parameter(Mandatory)][string]$Path,
+        [Parameter(Mandatory)][string[]]$Steps,
+        [string]$Login = "doctor@aybek.hospital",
+        [string]$Password = "mamonaminyar",
+        [int]$Port = 3000
+    )
+
+    Write-Host ""
+    Write-Host ("=" * 74) -ForegroundColor DarkCyan
+    Write-Host "  $Name WIZARD - Aybek Ten-Bed Specialy Surgical Hospital" -ForegroundColor Cyan
+    Write-Host ("=" * 74) -ForegroundColor DarkCyan
+    Write-Host ""
+
+    # 1. is the server up?
+    $base = "http://localhost:$Port"
+    $up = $false
+    try {
+        $r = Invoke-WebRequest -Uri "$base/hms/login" -UseBasicParsing -TimeoutSec 4
+        $up = ($r.StatusCode -eq 200)
+    } catch { $up = $false }
+
+    if (-not $up) {
+        Write-Host "  The hospital server is not running." -ForegroundColor Yellow
+        if (-not (Confirm-Action "Start it now in a new window?" -DefaultYes)) {
+            Write-Host "  Start it later with .\scripts\install\04-start.ps1" -ForegroundColor Gray
+            Read-Host "Press Enter to close" | Out-Null
+            return
+        }
+        $starter = Join-Path (Split-Path -Parent (Split-Path -Parent $PSScriptRoot)) "install\04-start.ps1"
+        Start-Process powershell -ArgumentList "-NoExit","-ExecutionPolicy","Bypass","-File","`"$starter`"","-NoBrowser"
+        for ($i = 0; $i -lt 90; $i++) {
+            Start-Sleep -Seconds 2
+            try {
+                $r = Invoke-WebRequest -Uri "$base/hms/login" -UseBasicParsing -TimeoutSec 2
+                if ($r.StatusCode -eq 200) { $up = $true; break }
+            } catch { }
+        }
+        if (-not $up) {
+            Write-Host "  The server did not answer in three minutes. Check the other window for errors." -ForegroundColor Red
+            Read-Host "Press Enter to close" | Out-Null
+            return
+        }
+    }
+    Write-Host "  Server is running at $base" -ForegroundColor Green
+    Write-Host ""
+
+    # 2. the checklist
+    Write-Host "  Your shift, step by step" -ForegroundColor Cyan
+    Write-Host "  ------------------------"
+    $i = 1
+    foreach ($s in $Steps) {
+        Write-Host ("  {0}. {1}" -f $i, $s)
+        $i++
+    }
+    Write-Host ""
+    Write-Host "  Sign in as : $Login" -ForegroundColor Yellow
+    Write-Host "  Password   : $Password" -ForegroundColor Yellow
+    Write-Host ""
+
+    # 3. open the right screen
+    $url = "$base$Path"
+    if (Confirm-Action "Open $url now?" -DefaultYes) { Start-Process $url }
+
+    Write-Host ""
+    Write-Host "  Everything you do here is written to the audit trail, and the" -ForegroundColor DarkGray
+    Write-Host "  health monitor checks your department every 30 minutes." -ForegroundColor DarkGray
+    Write-Host ""
+    Read-Host "Press Enter to close" | Out-Null
+}
