+                    <td className="hms-td">{r.department}</td>
+                    <td className="hms-td font-semibold" style={{ color: r.risk > 60 ? "#b91c1c" : r.risk > 35 ? "#b45309" : "#0b7a58" }}>{digitsOf(lang, r.risk)}%</td>
+                  </tr>
+                ))}
