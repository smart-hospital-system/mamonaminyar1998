+      className={cn(
+        "btn",
+        VARIANT_CLASS[variant] ?? "btn-outline",
+        size === "sm" && "text-[0.75rem] px-2.5 py-1.5 gap-1.5",
+        size === "lg" && "text-sm px-4 py-2.5",
