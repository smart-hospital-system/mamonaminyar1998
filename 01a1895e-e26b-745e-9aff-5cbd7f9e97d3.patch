+                      {t("shell.noAlarms")}
+                    </p>
+                  ) : (
+                    alerts.map((a) => (
+                      <Link
+                        key={a.id}
+                        href="/hms/alerts"
+                        className="block border-b px-3 py-2 last:border-0 hover:bg-[var(--hms-surface-2)]"
+                        style={{ borderColor: "var(--hms-border)" }}
