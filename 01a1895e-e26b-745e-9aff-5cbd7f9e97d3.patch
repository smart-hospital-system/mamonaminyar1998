+
+export function BillingBoard({ invoices, patients }: { invoices: Inv[]; patients: { id: string; name: string; mrn: string }[] }) {
+  const router = useRouter();
+  const tx = useTx();
+  const { lang } = useLang();
+  const [q, setQ] = useState("");
+  const [busy, setBusy] = useState<string | null>(null);
