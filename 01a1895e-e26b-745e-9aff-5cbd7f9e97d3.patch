+          <div className="mt-3"><Donut data={mix.map((m) => ({ label: m.department, value: m.n }))} center={{ top: digitsOf(lang, mix.reduce((a, b) => a + b.n, 0)), bottom: tr("visits", "مراجعه") }} /></div>
+        </Panel>
