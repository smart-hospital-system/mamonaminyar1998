@@ -0,0 +1,150 @@
+"use client";
+
+import {
+  Activity, BedDouble, CalendarDays, CreditCard, FlaskConical, Pill, ScanLine, Scissors, Stethoscope,
+} from "lucide-react";
+import Link from "next/link";
+import { useMemo, useState } from "react";
+import { useLang } from "./lang-provider";
+
+/**
+ * One chronological spine for the whole chart.
+ *
+ * The old page listed each table separately, which meant a surgeon had to hold
+ * four lists in their head to reconstruct a stay. This merges every event —
+ * encounter, prescription, lab, imaging, admission, operation, invoice — into a
+ * single time-ordered story, filterable by kind, with the source of each line
+ * one click away.
+ */
+
+export type TimelineEvent = {
+  id: string;
+  kind: "encounter" | "rx" | "lab" | "imaging" | "admission" | "surgery" | "invoice";
+  at: string;
+  title: string;
+  detail?: string;
+  status?: string;
+  href?: string;
+};
+
+const KIND: Record<TimelineEvent["kind"], { icon: typeof Activity; en: string; fa: string; color: string }> = {
+  encounter: { icon: Stethoscope, en: "Visit", fa: "معاینه", color: "#0e9488" },
+  rx: { icon: Pill, en: "Prescription", fa: "نسخه", color: "#2563eb" },
+  lab: { icon: FlaskConical, en: "Laboratory", fa: "لابراتوار", color: "#7c3aed" },
+  imaging: { icon: ScanLine, en: "Imaging", fa: "اکسری", color: "#0891b2" },
+  admission: { icon: BedDouble, en: "Ward", fa: "بستری", color: "#d97706" },
+  surgery: { icon: Scissors, en: "Theatre", fa: "عملیات", color: "#b91c1c" },
+  invoice: { icon: CreditCard, en: "Billing", fa: "بل", color: "#4d7c0f" },
+};
+
+export function PatientTimeline({ events }: { events: TimelineEvent[] }) {
+  const { tx, lang } = useLang();
+  const [filter, setFilter] = useState<"all" | TimelineEvent["kind"]>("all");
+
+  const kinds = useMemo(() => {
+    const set = new Set(events.map((e) => e.kind));
+    return Array.from(set);
+  }, [events]);
+
+  const shown = useMemo(
+    () => (filter === "all" ? events : events.filter((e) => e.kind === filter)).slice().sort((a, b) => b.at.localeCompare(a.at)),
+    [events, filter]
+  );
+
+  return (
+    <div className="hms-card">
+      <div className="flex flex-wrap items-center justify-between gap-2 border-b px-3.5 py-2.5" style={{ borderColor: "var(--hms-border)" }}>
+        <div>
+          <p className="text-[0.84rem] font-semibold">{tx("One timeline", "یک خط زمانی")}</p>
+          <p className="text-[0.64rem]" style={{ color: "var(--hms-muted)" }}>
+            {tx("Every visit, prescription, test and bill in one story — newest first.", "هر معاینه، نسخه، تست و بل در یک داستان — جدیدترین اول.")}
+          </p>
+        </div>
+        <div className="flex flex-wrap gap-1">
+          <button onClick={() => setFilter("all")} data-active={filter === "all"} className="hms-tab !h-7 !text-[0.66rem]">
+            {tx("All", "همه")} <span style={{ color: "var(--hms-faint)" }}>{events.length}</span>
+          </button>
+          {kinds.map((k) => {
+            const K = KIND[k];
+            return (
+              <button key={k} onClick={() => setFilter(k)} data-active={filter === k} className="hms-tab !h-7 !text-[0.66rem]">
+                <K.icon size={11} /> {tx(K.en, K.fa)}
+              </button>
+            );
+          })}
+        </div>
+      </div>
+
+      <div className="max-h-[26rem] overflow-y-auto px-3.5 py-3">
+        {shown.length === 0 && (
+          <p className="py-6 text-center text-[0.72rem]" style={{ color: "var(--hms-faint)" }}>
+            {tx("Nothing recorded of this kind yet.", "از این نوع هنوز چیزی ثبت نشده.")}
+          </p>
+        )}
+        <ol className="relative space-y-3 border-s ps-3.5" style={{ borderColor: "var(--hms-border)" }}>
+          {shown.map((e) => {
+            const K = KIND[e.kind];
+            const Icon = K.icon;
+            const body = (
+              <>
+                <div className="flex flex-wrap items-center gap-1.5">
+                  <span className="rounded px-1.5 py-0.5 text-[0.56rem] font-bold uppercase tracking-[0.08em]" style={{ background: `color-mix(in srgb, ${K.color} 12%, transparent)`, color: K.color }}>
+                    {tx(K.en, K.fa)}
+                  </span>
+                  <p className="min-w-0 flex-1 truncate text-[0.74rem] font-medium">{e.title}</p>
+                  {e.status && <span className="text-[0.58rem] capitalize" style={{ color: "var(--hms-faint)" }}>{e.status}</span>}
+                </div>
+                {e.detail && <p className="mt-0.5 text-[0.66rem] leading-relaxed" style={{ color: "var(--hms-muted)" }}>{e.detail}</p>}
+                <p className="mt-0.5 text-[0.58rem]" style={{ color: "var(--hms-faint)" }} data-num>
+                  {new Date(e.at).toLocaleString(lang === "fa" ? "fa-AF" : "en-GB", { dateStyle: "medium", timeStyle: "short" })}
+                </p>
+              </>
+            );
+            return (
+              <li key={`${e.kind}-${e.id}`} className="relative">
+                <span
+                  className="absolute -start-[1.42rem] top-0.5 grid h-4 w-4 place-items-center rounded-full ring-2"
+                  style={{ background: `color-mix(in srgb, ${K.color} 16%, var(--hms-surface))`, color: K.color, ["--tw-ring-color" as string]: "var(--hms-surface)" }}
+                >
+                  <Icon size={9} />
+                </span>
+                {e.href ? (
+                  <Link href={e.href} className="block rounded-lg px-1.5 py-1 transition hover:bg-[var(--hms-surface-2)]">
+                    {body}
+                  </Link>
+                ) : (
+                  <div className="px-1.5 py-1">{body}</div>
+                )}
+              </li>
+            );
+          })}
+        </ol>
+      </div>
+    </div>
+  );
+}
+
+/** A compact strip of things that must not be missed before the next decision. */
+export function SafetyStrip({ items }: { items: { tone: "good" | "warn" | "bad"; label: string; href?: string }[] }) {
+  const { tx } = useLang();
+  if (!items.length) {
+    return (
+      <div className="flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-[0.68rem]" style={{ background: "color-mix(in srgb,#10b981 10%, transparent)", color: "#0b7a58" }}>
+        <Activity size={12} /> {tx("Nothing needs attention on this chart right now.", "همین حالا چیزی در این پرونده نیاز به توجه ندارد.")}
+      </div>
+    );
+  }
+  const color = { good: "#0f9d6e", warn: "#b45309", bad: "#b91c1c" };
+  return (
+    <div className="flex flex-wrap gap-1.5">
+      {items.map((i) => (
+        <span key={i.label} className="rounded-full px-2.5 py-1 text-[0.66rem] font-medium" style={{ background: `color-mix(in srgb, ${color[i.tone]} 11%, transparent)`, color: color[i.tone] }}>
+          {i.label}
+        </span>
+      ))}
+    </div>
+  );
+}
+
+/** Unused import guard for icons referenced only in the type map. */
+export const _timelineIcons = { Activity, CalendarDays };
diff --git a/components/hms/toast.tsx b/components/hms/toast.tsx
new file mode 100644
index 0000000..2cf65c9
--- /dev/null
+++ b/components/hms/toast.tsx
@@ -0,0 +1,106 @@
+"use client";
+
+import { createContext, useCallback, useContext, useEffect, useMemo, useRef, useState, type ReactNode } from "react";
+import { AlertTriangle, CheckCircle2, Info, X, XCircle } from "lucide-react";
+import { useLang } from "./lang-provider";
+
+/**
+ * A single, quiet place for "it worked" / "it did not".
+ *
+ * Every screen used to invent its own inline message; some swallowed failures
+ * entirely. The workspace now shares one toaster, so a pharmacy dispense, a
+ * settings save and a licence activation all report the same way — and a
+ * failure can never be mistaken for success.
+ */
+
+export type ToastTone = "good" | "bad" | "warn" | "info";
+export type Toast = { id: number; tone: ToastTone; title: string; body?: string; ttl?: number };
+
+type Ctx = {
+  push: (t: Omit<Toast, "id">) => void;
+  success: (title: string, body?: string) => void;
+  error: (title: string, body?: string) => void;
+  info: (title: string, body?: string) => void;
+};
+
+const ToastCtx = createContext<Ctx | null>(null);
+
+export function useToast() {
+  const ctx = useContext(ToastCtx);
+  if (!ctx) throw new Error("useToast must be used inside <ToastProvider>");
+  return ctx;
+}
+
+const ICONS: Record<ToastTone, typeof Info> = {
+  good: CheckCircle2,
+  bad: XCircle,
+  warn: AlertTriangle,
+  info: Info,
+};
+
+const COLORS: Record<ToastTone, string> = {
+  good: "#0f9d6e",
+  bad: "#dc2626",
+  warn: "#d97706",
+  info: "var(--hms-brand)",
+};
+
+export function ToastProvider({ children }: { children: ReactNode }) {
+  const { tx } = useLang();
+  const [items, setItems] = useState<Toast[]>([]);
+  const seq = useRef(0);
+
+  const remove = useCallback((id: number) => setItems((list) => list.filter((t) => t.id !== id)), []);
+
+  const push = useCallback(
+    (t: Omit<Toast, "id">) => {
+      const id = ++seq.current;
+      setItems((list) => [...list.slice(-3), { ...t, id }]);
+      const ttl = t.ttl ?? (t.tone === "bad" ? 7000 : 4200);
+      setTimeout(() => remove(id), ttl);
+    },
+    [remove]
+  );
+
+  const api = useMemo<Ctx>(
+    () => ({
+      push,
+      success: (title, body) => push({ tone: "good", title, body }),
+      error: (title, body) => push({ tone: "bad", title, body }),
+      info: (title, body) => push({ tone: "info", title, body }),
+    }),
+    [push]
+  );
+
+  // Announce to screen readers without stealing focus.
+  useEffect(() => {
+    const last = items[items.length - 1];
+    if (!last) return;
+    const el = document.getElementById("hms-live");
+    if (el) el.textContent = `${last.title} ${last.body ?? ""}`;
+  }, [items]);
+
+  return (
+    <ToastCtx.Provider value={api}>
+      {children}
+      <div className="hms-toaster" role="region" aria-live="polite" aria-label={tx("Notifications", "اطلاعیه‌ها")}>
+        <span id="hms-live" className="sr-only" />
+        {items.map((t) => {
+          const Icon = ICONS[t.tone];
+          return (
+            <div key={t.id} className="hms-toast" data-tone={t.tone}>
+              <Icon size={15} style={{ color: COLORS[t.tone], marginTop: 1, flexShrink: 0 }} />
+              <div className="min-w-0 flex-1">
+                <p className="text-[0.76rem] font-semibold leading-snug">{t.title}</p>
+                {t.body && <p className="mt-0.5 text-[0.68rem] leading-relaxed" style={{ color: "var(--hms-muted)" }}>{t.body}</p>}
+              </div>
+              <button onClick={() => remove(t.id)} aria-label={tx("Dismiss", "بستن")} className="shrink-0 rounded p-0.5" style={{ color: "var(--hms-faint)" }}>
+                <X size={12} />
+              </button>
+            </div>
+          );
+        })}
+      </div>
+    </ToastCtx.Provider>
+  );
+}
diff --git a/components/hms/ui.tsx b/components/hms/ui.tsx
new file mode 100644
index 0000000..e9d22c9
--- /dev/null
+++ b/components/hms/ui.tsx
@@ -0,0 +1,297 @@
+"use client";
+
+import { cn } from "@/lib/utils";
+import { initials } from "@/lib/hms/format";
+import { statusText } from "@/lib/hms/i18n";
+import { useLang } from "./lang-provider";
+import type { ReactNode } from "react";
+
+/* --------------------------------------------------------------- surfaces */
+
+export function Panel({
+  children,
+  className,
+  padded = true,
+}: {
+  children: ReactNode;
+  className?: string;
+  padded?: boolean;
+}) {
+  return <div className={cn("hms-card", padded && "p-3.5", className)}>{children}</div>;
+}
+
+export function SectionTitle({
+  title,
+  subtitle,
+  icon,
+  action,
+  className,
+}: {
+  title: string;
+  subtitle?: string;
+  icon?: ReactNode;
+  action?: ReactNode;
+  className?: string;
+}) {
+  return (
+    <div className={cn("flex items-start justify-between gap-3", className)}>
+      <div className="flex min-w-0 items-start gap-2.5">
+        {icon && (
+          <span
+            className="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg"
+            style={{ background: "var(--hms-brand-soft)", color: "var(--hms-brand-ink)" }}
+          >
+            {icon}
+          </span>
+        )}
+        <div className="min-w-0">
+          <h3 className="truncate text-[0.84rem] font-semibold tracking-[-0.01em]">{title}</h3>
+          {subtitle && <p className="mt-0.5 text-[0.68rem] leading-snug" style={{ color: "var(--hms-muted)" }}>{subtitle}</p>}
+        </div>
+      </div>
+      {action}
+    </div>
+  );
+}
+
+/* ------------------------------------------------------------------ tiles */
+
+export function Stat({
+  label,
+  value,
+  hint,
+  tone = "brand",
+  icon,
+  trend,
+  onClick,
+}: {
+  label: string;
+  value: ReactNode;
+  hint?: string;
+  tone?: "brand" | "good" | "warn" | "bad" | "info";
+  icon?: ReactNode;
+  trend?: number;
+  onClick?: () => void;
+}) {
+  const tones: Record<string, { bg: string; fg: string }> = {
+    brand: { bg: "var(--hms-brand-soft)", fg: "var(--hms-brand-ink)" },
+    good: { bg: "color-mix(in srgb, #10b981 14%, transparent)", fg: "#0b7a58" },
+    warn: { bg: "color-mix(in srgb, #f59e0b 16%, transparent)", fg: "#92570a" },
+    bad: { bg: "color-mix(in srgb, #ef4444 14%, transparent)", fg: "#a51c1c" },
+    info: { bg: "color-mix(in srgb, #3b82f6 14%, transparent)", fg: "#1d4ed8" },
+  };
+  const t = tones[tone];
+  return (
+    <button
+      type="button"
+      onClick={onClick}
+      className={cn("hms-card flex items-center gap-3 p-3 text-left transition", onClick && "hover:-translate-y-px hover:shadow-md")}
+    >
+      {icon && (
+        <span className="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl" style={{ background: t.bg, color: t.fg }}>
+          {icon}
+        </span>
+      )}
+      <span className="min-w-0 flex-1">
+        <span className="block truncate text-[0.62rem] font-semibold uppercase tracking-[0.06em]" style={{ color: "var(--hms-faint)" }}>
+          {label}
+        </span>
+        <span className="mt-0.5 flex items-baseline gap-1.5">
+          <span className="text-[1.15rem] font-semibold leading-none tracking-[-0.02em]">{value}</span>
+          {typeof trend === "number" && (
+            <span
+              className="text-[0.62rem] font-semibold"
+              style={{ color: trend >= 0 ? "#0b7a58" : "#b91c1c" }}
+            >
+              {trend >= 0 ? "▲" : "▼"} {Math.abs(trend)}%
+            </span>
+          )}
+        </span>
+        {hint && <span className="mt-0.5 block truncate text-[0.63rem]" style={{ color: "var(--hms-muted)" }}>{hint}</span>}
+      </span>
+    </button>
+  );
+}
+
+/* ----------------------------------------------------------------- status */
+
+export type Tone = "good" | "warn" | "bad" | "info" | "neutral" | "brand";
+
+const TONE_STYLE: Record<Tone, { bg: string; fg: string; border: string }> = {
+  good: { bg: "color-mix(in srgb, #10b981 13%, transparent)", fg: "#0b7a58", border: "color-mix(in srgb, #10b981 30%, transparent)" },
+  warn: { bg: "color-mix(in srgb, #f59e0b 15%, transparent)", fg: "#8a5209", border: "color-mix(in srgb, #f59e0b 32%, transparent)" },
+  bad: { bg: "color-mix(in srgb, #ef4444 13%, transparent)", fg: "#a51c1c", border: "color-mix(in srgb, #ef4444 30%, transparent)" },
+  info: { bg: "color-mix(in srgb, #3b82f6 13%, transparent)", fg: "#1d4ed8", border: "color-mix(in srgb, #3b82f6 30%, transparent)" },
+  brand: { bg: "var(--hms-brand-soft)", fg: "var(--hms-brand-ink)", border: "color-mix(in srgb, var(--hms-brand) 28%, transparent)" },
+  neutral: { bg: "var(--hms-surface-3)", fg: "var(--hms-muted)", border: "var(--hms-border)" },
+};
+
+export function Pill({ children, tone = "neutral", dot, className }: { children: ReactNode; tone?: Tone; dot?: boolean; className?: string }) {
+  const s = TONE_STYLE[tone];
+  return (
+    <span className={cn("hms-pill", className)} style={{ background: s.bg, color: s.fg, borderColor: s.border }}>
+      {dot && <span className="h-1.5 w-1.5 rounded-full" style={{ background: "currentColor", opacity: 0.75 }} />}
+      {children}
+    </span>
+  );
+}
+
+const STATUS_TONE: Record<string, Tone> = {
+  completed: "good", confirmed: "info", waiting: "warn", scheduled: "info", in_progress: "warn",
+  cancelled: "neutral", no_show: "bad", pending: "warn", dispensed: "good", signed: "good",
+  verified: "good", ordered: "warn", collected: "info", reported: "good", requested: "warn",
+  occupied: "bad", available: "good", cleaning: "warn", blocked: "neutral", admitted: "info",
+  discharged: "neutral", paid: "good", partial: "warn", unpaid: "bad", active: "good", expired: "bad",
+  open: "bad", acknowledged: "warn", resolved: "good", critical: "bad", warning: "warn", info: "info",
+};
+
+export function Status({ value, className }: { value: string; className?: string }) {
+  const { lang } = useLang();
+  const tone = STATUS_TONE[value] ?? "neutral";
+  return (
+    <Pill tone={tone} dot className={cn("capitalize", className)}>
+      {statusText(lang, value)}
+    </Pill>
+  );
+}
+
+/* ----------------------------------------------------------------- inputs */
+
+export function Btn({
+  children,
+  variant = "outline",
+  size = "md",
+  loading,
+  icon,
+  className,
+  ...rest
+}: React.ButtonHTMLAttributes<HTMLButtonElement> & {
+  variant?: "primary" | "outline" | "soft" | "ghost";
+  size?: "sm" | "md";
+  loading?: boolean;
+  icon?: ReactNode;
+}) {
+  const map = { primary: "hms-btn-primary", outline: "", soft: "hms-btn-soft", ghost: "hms-btn-ghost" };
+  return (
+    <button className={cn("hms-btn", map[variant], size === "sm" && "hms-btn-sm", className)} disabled={loading || rest.disabled} {...rest}>
+      {loading ? <Spinner /> : icon}
+      {children}
+    </button>
+  );
+}
+
+export function Spinner({ size = 13 }: { size?: number }) {
+  return (
+    <svg width={size} height={size} viewBox="0 0 24 24" className="animate-spin">
+      <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" strokeOpacity="0.2" strokeWidth="3" />
+      <path d="M21 12a9 9 0 0 0-9-9" fill="none" stroke="currentColor" strokeWidth="3" strokeLinecap="round" />
+    </svg>
+  );
+}
+
+export function Field({
+  label,
+  children,
+  hint,
+  className,
+}: {
+  label: string;
+  children: ReactNode;
+  hint?: string;
+  className?: string;
+}) {
+  return (
+    <label className={cn("block", className)}>
+      <span className="hms-label">{label}</span>
+      {children}
+      {hint && <span className="mt-1 block text-[0.62rem]" style={{ color: "var(--hms-faint)" }}>{hint}</span>}
+    </label>
+  );
+}
+
