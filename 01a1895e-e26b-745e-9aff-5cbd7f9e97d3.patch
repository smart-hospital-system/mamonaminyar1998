diff --git a/aybek-hms/disc/START-HERE.bat b/aybek-hms/disc/START-HERE.bat
new file mode 100644
index 0000000..cd0a493
--- /dev/null
+++ b/aybek-hms/disc/START-HERE.bat
@@ -0,0 +1,129 @@
+@echo off
+setlocal
+title Aybek Ten-Bed Specialy Surgical Hospital - install from disc
+cd /d "%~dp0"
+
+echo ==============================================================
+echo   Aybek Ten-Bed Specialy Surgical Hospital   -   version 7
+echo   Installing from this disc onto the local disk
+echo ==============================================================
+echo.
+echo   Persian guide ....... RAHNAMA-FA.html  (open in a browser)
+echo   English guide ....... DOCS\INSTALL-WINDOWS.md
+echo   Give to a colleague . COPY-TO-ANOTHER-PC\*.zip
+echo.
+
+rem ---------------------------------------------------------------- Node.js
+where node >nul 2>nul
+if errorlevel 1 goto nonode
+for /f "tokens=1 delims=v." %%a in ('node -v') do set MAJOR=%%a
+if not defined MAJOR goto nonode
+if %MAJOR% LSS 20 goto oldnode
+
+rem ---------------------------------------------------------------- target
+set "TARGET=C:\AybekHMS"
+if exist "%TARGET%\package.json" goto update
+
+echo [1/5] Copying the hospital to %TARGET% ...
+robocopy "%~dp0APP" "%TARGET%" /E /NFL /NDL /NJH /NJS /NP /XF slotly.db slotly.db-wal slotly.db-shm >nul
+if errorlevel 8 goto copyfail
+goto copied
+
+:update
+echo A copy already exists in %TARGET%.
+choice /C YN /M "  Update the program files and keep the existing patient data"
+if errorlevel 2 goto cancelled
+echo [1/5] Updating the program in %TARGET% ...
+robocopy "%~dp0APP" "%TARGET%" /E /NFL /NDL /NJH /NJS /NP /XF slotly.db slotly.db-wal slotly.db-shm >nul
+if errorlevel 8 goto copyfail
+goto copied
+
+:copied
+echo [1/5] Copy finished.
+cd /d "%TARGET%"
+
+rem ---------------------------------------------------------------- env check
+echo.
+echo [2/5] Checking the computer
+powershell -NoProfile -ExecutionPolicy Bypass -File "%TARGET%\aybek-hms\scripts\install\01-setup.ps1" -NoPause
+if errorlevel 1 goto failed
+
+rem ---------------------------------------------------------------- packages
+echo.
+echo [3/5] Installing the program libraries (first time only, 3-10 minutes)
+if exist "%TARGET%\node_modules\next" (
+    echo     Already installed - skipping.
+) else (
+    powershell -NoProfile -ExecutionPolicy Bypass -File "%TARGET%\aybek-hms\scripts\install\02-install.ps1" -NoPause
+    if errorlevel 1 goto failed
+)
+
+rem ---------------------------------------------------------------- data
+echo.
+echo [4/5] Preparing the database
+if exist "%TARGET%\data\slotly.db" (
+    echo     Database found - keeping the existing patients.
+) else (
+    if exist "%TARGET%\data\demo-hospital.db" (
+        echo     Installing the demonstration hospital that ships on this disc.
+        copy /Y "%TARGET%\data\demo-hospital.db" "%TARGET%\data\slotly.db" >nul
+    ) else (
+        powershell -NoProfile -ExecutionPolicy Bypass -File "%TARGET%\aybek-hms\scripts\install\03-seed.ps1" -NoPause
+        if errorlevel 1 goto failed
+    )
+)
+
+echo.
+echo [5/5] Starting the server - keep this window open while you work.
+echo       The browser opens by itself as soon as the hospital is ready.
+echo.
+powershell -NoProfile -ExecutionPolicy Bypass -File "%TARGET%\aybek-hms\scripts\install\04-start.ps1"
+goto done
+
+rem ---------------------------------------------------------------- errors
+:nonode
+echo.
+echo [X] Node.js was not found on this computer.
+echo.
+echo     Install Node.js 20 LTS or newer, then double-click START-HERE.bat again.
+echo     Online .... https://nodejs.org/en/download
+echo     Offline ... put the installer in TOOLS\ and read
+echo                 TOOLS\PUT-NODEJS-INSTALLER-HERE.txt
+echo.
+echo     Persian explanation: RAHNAMA-FA.html - section 6
+pause
+exit /b 1
+
+:oldnode
+echo.
+echo [X] This computer has an old Node.js. Version 20 or newer is required.
+echo     Remove the old one, install the new one, run this file again.
+pause
+exit /b 1
+
+:copyfail
+echo.
+echo [X] Could not copy the files to %TARGET%.
+echo     Close any window that is using that folder, or right-click
+echo     START-HERE.bat and choose "Run as administrator".
+pause
+exit /b 1
+
+:failed
+echo.
+echo [X] A setup step failed. The message above says why.
+echo     For a full diagnosis run:
+echo        powershell -ExecutionPolicy Bypass -File "%TARGET%\aybek-hms\scripts\install\10-doctor.ps1"
+pause
+exit /b 1
+
+:cancelled
+echo Nothing was changed.
+pause
+exit /b 0
+
+:done
+echo.
+echo The server stopped. Your data is in %TARGET%\data\slotly.db
+pause
+exit /b 0
diff --git a/aybek-hms/disc/TOOLS/MAKE-ISO.ps1 b/aybek-hms/disc/TOOLS/MAKE-ISO.ps1
new file mode 100644
index 0000000..0c0a895
--- /dev/null
+++ b/aybek-hms/disc/TOOLS/MAKE-ISO.ps1
@@ -0,0 +1,161 @@
+<#
+.SYNOPSIS
+  Turns a disc folder into an .iso image, and optionally burns it.
+
+.DESCRIPTION
+  Uses the IMAPI2 component that is built into Windows, so nothing has to be
+  installed. Running with -Burn writes the image straight to an empty CD/DVD
+  in the drive you name.
+
+.PARAMETER Source
+  The disc folder. Defaults to the folder that contains this TOOLS folder.
+
+.PARAMETER Iso
+  Where to write the .iso file. Defaults to a file next to the disc folder.
+
+.PARAMETER Burn
+  After building the image, burn it to the disc in -Drive.
+
+.PARAMETER Drive
+  Drive letter of the writer, for example "E:". Only used with -Burn.
+
+.EXAMPLE
+  .\MAKE-ISO.ps1 -Iso "D:\Aybek-Hospital-HMS-v4.iso"
+
+.EXAMPLE
+  .\MAKE-ISO.ps1 -Iso "D:\Aybek.iso" -Burn -Drive "E:"
+
+.NOTES
+  If burning fails, close any program that is using the drive, insert a blank
+  disc, and try again - or right-click the .iso in Windows Explorer and choose
+  "Burn disc image".
+#>
+
+param(
+    [string]$Source,
+    [string]$Iso,
+    [switch]$Burn,
+    [string]$Drive,
+    [string]$VolumeName = "AYBEK_HMS_V4"
+)
+
+$ErrorActionPreference = "Stop"
+
+function Say($msg)  { Write-Host "  $msg" }
+function Ok($msg)   { Write-Host "  [OK] $msg" -ForegroundColor Green }
+function Warn($msg) { Write-Host "  [!]  $msg" -ForegroundColor Yellow }
+function Die($msg)  { Write-Host "  [X]  $msg" -ForegroundColor Red; exit 1 }
+
+if (-not $Source) { $Source = Split-Path $PSScriptRoot -Parent }
+if (-not (Test-Path -LiteralPath $Source)) { Die "Disc folder not found: $Source" }
+$Source = (Resolve-Path -LiteralPath $Source).Path
+
+if (-not $Iso) {
+    $Iso = Join-Path (Split-Path $Source -Parent) ((Split-Path $Source -Leaf) + ".iso")
+}
+
+Write-Host ""
+Write-Host "  AYBEK HOSPITAL - BUILD DISC IMAGE" -ForegroundColor Cyan
+Write-Host "  ---------------------------------"
+Say "Source : $Source"
+Say "Image  : $Iso"
+Write-Host ""
+
+# ------------------------------------------------------------------ size check
+$bytes = (Get-ChildItem -LiteralPath $Source -Recurse -File | Measure-Object -Property Length -Sum).Sum
+$mb = [math]::Round($bytes / 1MB, 1)
+Say ("Content: {0} MB" -f $mb)
+if ($mb -gt 700) {
+    Warn "This is larger than a 700 MB CD. Use a DVD, or a dual-layer disc for more than 4.7 GB."
+}
+
+# ------------------------------------------------------------------ build image
+Say "Building the file system image ..."
+try {
+    $fsi = New-Object -ComObject IMAPI2FS.MsftFileSystemImage
+    $fsi.FileSystemsToCreate = 3          # ISO9660 + Joliet (long file names)
+    $fsi.VolumeName = $VolumeName
+    $fsi.Root.AddTree($Source, $false)
+    $result = $fsi.CreateResultImage()
+}
+catch {
+    Die ("Windows could not build the image: " + $_.Exception.Message)
+}
+
+$stream = $result.ImageStream
+if (Test-Path -LiteralPath $Iso) { Remove-Item -LiteralPath $Iso -Force }
+
+Say "Writing $Iso ..."
+$buffer = New-Object byte[] 524288
+$read = 0
+$out = [System.IO.File]::Create($Iso)
+try {
+    while ($true) {
+        $stream.Read($buffer, $buffer.Length, [ref]$read)
+        if ($read -le 0) { break }
+        $out.Write($buffer, 0, $read)
+    }
+}
+finally {
+    $out.Close()
+}
+
+$isoSize = [math]::Round((Get-Item -LiteralPath $Iso).Length / 1MB, 1)
+Ok ("Image written: {0} MB" -f $isoSize)
+
+# ------------------------------------------------------------------ checksum
+$hash = (Get-FileHash -LiteralPath $Iso -Algorithm SHA256).Hash
+Say "SHA-256: $hash"
+
+# ------------------------------------------------------------------ burning
+if (-not $Burn) {
+    Write-Host ""
+    Write-Host "  How to burn it by hand:" -ForegroundColor Cyan
+    Say "1. Insert a blank CD or DVD."
+    Say "2. In Windows Explorer, right-click the .iso file."
+    Say "3. Choose 'Burn disc image', pick the drive, press Burn."
+    Write-Host ""
+    exit 0
+}
+
+if (-not $Drive) { Die "Give the writer drive letter, for example: -Drive E:" }
+$Drive = $Drive.TrimEnd('\')
+if ($Drive -notmatch '^[A-Za-z]:$') { Die "Drive must look like E:" }
+
+Say "Looking for the writer in $Drive ..."
+try {
+    $discMaster = New-Object -ComObject IMAPI2.MsftDiscMaster2
+    $recorder = $null
+    for ($i = 0; $i -lt $discMaster.Count; $i++) {
+        $id = $discMaster.Item($i)
+        $candidate = New-Object -ComObject IMAPI2.MsftDiscRecorder2
+        $candidate.InitializeDiscRecorder($id)
+        foreach ($path in $candidate.VolumePathNames) {
+            if ($path -eq $Drive) { $recorder = $candidate }
+        }
+    }
+    if (-not $recorder) { Die "No writer found on $Drive. Check the drive letter with: Get-Volume" }
+
+    $format = New-Object -ComObject IMAPI2.MsftDiscFormat2Data
+    $format.Recorder = $recorder
+    $format.ClientName = "Aybek Hospital"
+    $format.BurnVerificationEnabled = $true
+
+    if (-not $format.IsCurrentMediaSupported($recorder)) {
+        Die "The disc in $Drive cannot be written. Insert a blank CD-R/DVD-R and try again."
+    }
+
+    Say "Burning ... this can take several minutes. Do not open the drive."
+    $stream.Seek(0, 0) | Out-Null
+    $format.Write($stream)
+    Ok "Disc burned and verified."
+}
+catch {
+    Warn ("Burning stopped: " + $_.Exception.Message)
+    Say  "The .iso file is still complete: $Iso"
+    Say  "Right-click it in Windows Explorer and choose 'Burn disc image'."
+    exit 1
+}
+
+Write-Host ""
+Say "Done. Label the disc: Aybek HMS v4 - $(Get-Date -Format 'yyyy-MM-dd')"
diff --git a/aybek-hms/disc/TOOLS/MAKE-OFFLINE-DVD.ps1 b/aybek-hms/disc/TOOLS/MAKE-OFFLINE-DVD.ps1
new file mode 100644
index 0000000..2d971ba
--- /dev/null
+++ b/aybek-hms/disc/TOOLS/MAKE-OFFLINE-DVD.ps1
@@ -0,0 +1,164 @@
+<#
+.SYNOPSIS
+  Builds a completely offline disc: the hospital plus its program libraries,
+  so the target computer never needs the internet.
+
+.DESCRIPTION
+  The disc that ships with the project is small (about 35 MB) because the
+  program libraries are normally downloaded once during installation. This
+  script copies those libraries (node_modules, about 500 MB) into the disc
+  folder, together with the Node.js installer if you put it in TOOLS first.
+
+  The result fits on a DVD, or on a 700 MB CD when the libraries are the
+  slim production set.
+
+.PARAMETER Target
+  Folder that will hold the offline disc. Default: C:\AybekDVD-Offline
+
+.PARAMETER App
+  The installed hospital folder that already has node_modules.
+  Default: C:\AybekHMS
+
+.PARAMETER NodeInstaller
+  Full path to the Node.js .msi (node-v22.x.x-x64.msi). Optional, but without
+  it the offline computer must install Node.js from somewhere else.
+
+.PARAMETER Iso
+  Also build an .iso from the result.
+
+.PARAMETER Burn
+  Burn the finished image; needs -Drive.
+
+.EXAMPLE
+  .\MAKE-OFFLINE-DVD.ps1 -Target "D:\AybekDVD-Offline" -NodeInstaller "C:\Users\Mamon\Downloads\node-v22.11.0-x64.msi"
+
+.EXAMPLE
+  .\MAKE-OFFLINE-DVD.ps1 -Target "D:\AybekDVD" -NodeInstaller "C:\node.msi" -Iso "D:\Aybek-offline.iso" -Burn -Drive "E:"
+#>
+
+param(
+    [string]$Target = "C:\AybekDVD-Offline",
+    [string]$App = "C:\AybekHMS",
+    [string]$NodeInstaller,
+    [string]$Iso,
+    [switch]$Burn,
+    [string]$Drive
+)
+
+$ErrorActionPreference = "Stop"
+
+function Say($m)  { Write-Host "  $m" }
+function Ok($m)   { Write-Host "  [OK] $m" -ForegroundColor Green }
+function Warn($m) { Write-Host "  [!]  $m" -ForegroundColor Yellow }
+function Die($m)  { Write-Host "  [X]  $m" -ForegroundColor Red; exit 1 }
+
+$disc = Split-Path $PSScriptRoot -Parent
+
+Write-Host ""
+Write-Host "  AYBEK HOSPITAL - BUILD OFFLINE DISC" -ForegroundColor Cyan
+Write-Host "  -----------------------------------"
+Say "Disc master : $disc"
+Say "Installed app: $App"
+Say "Output      : $Target"
+Write-Host ""
+
+if (-not (Test-Path -LiteralPath (Join-Path $disc "APP"))) { Die "Run this from the TOOLS folder of the Aybek disc." }
+if (-not (Test-Path -LiteralPath $App)) {
+    Die ("The installed hospital was not found at " + $App + ". Install it first with START-HERE.bat, or pass -App <folder>.")
+}
+if (-not (Test-Path -LiteralPath (Join-Path $App "node_modules"))) {
+    Die ("No node_modules in " + $App + ". Run 02-install.ps1 there first, so the libraries exist to copy.")
+}
+
+# ------------------------------------------------------------------ copy disc
+Say "1/4  Copying the disc content ..."
+if (Test-Path -LiteralPath $Target) {
+    Warn "Target already exists - updating it."
+} else {
+    New-Item -ItemType Directory -Path $Target | Out-Null
+}
+robocopy $disc $Target /E /NFL /NDL /NJH /NJS /NP | Out-Null
+if ($LASTEXITCODE -ge 8) { Die "Copy failed. Try running PowerShell as administrator." }
+Ok "Disc content copied."
+
+# ------------------------------------------------------------------ libraries
+Say "2/4  Copying the program libraries (this takes a few minutes, about 500 MB) ..."
+$destModules = Join-Path $Target "APP\node_modules"
+robocopy (Join-Path $App "node_modules") $destModules /E /NFL /NDL /NJH /NJS /NP | Out-Null
+if ($LASTEXITCODE -ge 8) { Die "Could not copy node_modules." }
+
+$optional = @(".next")
+foreach ($extra in $optional) {
+    $src = Join-Path $App $extra
+    if (Test-Path -LiteralPath $src) {
+        robocopy $src (Join-Path $Target ("APP\" + $extra)) /E /NFL /NDL /NJH /NJS /NP | Out-Null
+    }
+}
+Ok "Libraries copied."
+
+# ------------------------------------------------------------------ Node.js
+Say "3/4  Looking for the Node.js installer ..."
+$nodeTarget = Join-Path $Target "INSTALL-NODEJS-FIRST"
+New-Item -ItemType Directory -Force -Path $nodeTarget | Out-Null
+
+$found = $null
+if ($NodeInstaller) {
+    if (Test-Path -LiteralPath $NodeInstaller) { $found = $NodeInstaller }
+    else { Warn "Not found: $NodeInstaller" }
+}
+if (-not $found) {
+    $candidate = Get-ChildItem -LiteralPath (Join-Path $disc "TOOLS") -Filter "node-*-x64.msi" -ErrorAction SilentlyContinue | Select-Object -First 1
+    if ($candidate) { $found = $candidate.FullName }
+}
+if ($found) {
+    Copy-Item -LiteralPath $found -Destination $nodeTarget -Force
+    Ok ("Node.js installer included: " + (Split-Path $found -Leaf))
+} else {
+    Warn "No Node.js installer found. The offline computer must install Node.js 20+ separately."
+    Warn "Put node-vXX.x.x-x64.msi into TOOLS and run this script again, or pass -NodeInstaller <path>."
+}
+
+# ------------------------------------------------------------------ note
+$note = @"
+AYBEK TEN-BED SPECIALY SURGICAL HOSPITAL - OFFLINE DISC
+=======================================================
+
+This disc already contains the program libraries, so the computer does NOT
+need the internet.
+
+  1. If the folder INSTALL-NODEJS-FIRST contains a .msi file, install it first
+     (double-click, keep the default options). Skip this step if Node.js 20+
+     is already on the computer.
+  2. Double-click START-HERE.bat in the main disc folder.
+  3. Sign in at http://localhost:3000 as doctor@aybek.hospital
+
+Persian guide: RAHNAMA-FA.html
+Built: $(Get-Date -Format 'yyyy-MM-dd HH:mm')
+"@
+Set-Content -LiteralPath (Join-Path $Target "READ-ME-OFFLINE.txt") -Value $note -Encoding UTF8
+Ok "Offline note written."
+
+# ------------------------------------------------------------------ report
+Say "4/4  Done."
+$size = (Get-ChildItem -LiteralPath $Target -Recurse -File | Measure-Object -Property Length -Sum).Sum
+$mb = [math]::Round($size / 1MB, 0)
+Ok ("Offline disc folder is ready: {0} ({1} MB)" -f $Target, $mb)
+if ($mb -gt 700) {
+    Say "This is larger than a CD (700 MB) - burn it to a DVD."
+} else {
+    Say "It fits on a standard CD (700 MB)."
+}
+
+if ($Iso -or $Burn) {
+    if (-not $Iso) { $Iso = Join-Path (Split-Path $Target -Parent) "Aybek-offline.iso" }
+    $isoScript = Join-Path $PSScriptRoot "MAKE-ISO.ps1"
+    if ($Burn) {
+        & $isoScript -Source $Target -Iso $Iso -Burn -Drive $Drive
+    } else {
+        & $isoScript -Source $Target -Iso $Iso
+    }
+} else {
+    Write-Host ""
+    Say "Next: insert a blank DVD and copy the folder to it with Windows Explorer,"
+    Say "or run:  .\MAKE-ISO.ps1 -Source `"$Target`" -Iso `"D:\Aybek-offline.iso`" -Burn -Drive E:"
+}
diff --git a/aybek-hms/disc/TOOLS/PUT-NODEJS-INSTALLER-HERE.txt b/aybek-hms/disc/TOOLS/PUT-NODEJS-INSTALLER-HERE.txt
new file mode 100644
index 0000000..b23986c
--- /dev/null
+++ b/aybek-hms/disc/TOOLS/PUT-NODEJS-INSTALLER-HERE.txt
@@ -0,0 +1,31 @@
+PLACE THE NODE.JS INSTALLER IN THIS FOLDER
+==========================================
+
+Why: the hospital needs Node.js 20 or newer. If the target computer has no
+internet, put the official installer in this folder so the person installing
+can find it on the same disc.
+
+What to download (on a computer that has internet):
+
+    https://nodejs.org/en/download
+    Choose: Windows Installer (.msi)  -  x64  -  LTS
+
+Expected file name (any LTS version is fine):
+
+    node-v22.x.x-x64.msi
+
+Then:
+
+ 1. Copy the .msi into this TOOLS folder on the disc (before burning), or
+    just hand the .msi over together with the disc.
+ 2. 05-build.ps1 -OfflineTarget  copies it automatically when it is here.
+ 3. On the offline computer: double-click the .msi, install with the default
+    options, then run START-HERE.bat from the disc.
+
+Version check after installing (Command Prompt):
+
+    node -v        should print v20.x or higher
+    npm -v
+
+Nothing else is downloaded from the internet at run time: the hospital works
+fully offline once Node.js and the program libraries are in place.
