+  id TEXT PRIMARY KEY, code TEXT NOT NULL, severity TEXT NOT NULL, category TEXT NOT NULL,
+  title TEXT NOT NULL, detail TEXT, link TEXT, auto_fixable INTEGER NOT NULL DEFAULT 0,
