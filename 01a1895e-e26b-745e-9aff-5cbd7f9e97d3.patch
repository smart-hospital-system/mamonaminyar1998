+  "hms_lab_orders", "hms_imaging_orders", "hms_beds", "hms_admissions", "hms_medicines", "hms_surgeries",
+  "hms_invoices", "hms_alerts", "hms_audit", "hms_settings",
+];
+let ok = true;
+for (const t of tables) {
