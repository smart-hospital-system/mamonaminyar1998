+}
+
+/* =====================================================================
+   Aybek HMS — themed workspace
+   Every colour comes from CSS variables injected by the active theme, so
+   the whole hospital can be re-skinned from Settings → Look & feel.
+   ===================================================================== */
+.hms-root {
