+++ b/components/hms/palette.tsx
@@ -0,0 +1,285 @@
+"use client";
+
+import {
+  Activity, ArrowRight, Beaker, Command, CreditCard, FlaskConical, HeartPulse, KeyRound, LayoutDashboard,
+  Loader2, Pill, ScanLine, Search, Settings, Sparkles, Stethoscope, UserPlus, Users, Wallet, X,
+} from "lucide-react";
+import { useRouter } from "next/navigation";
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { useLang } from "./lang-provider";
+
+/**
+ * ⌘K — one box for the whole hospital.
+ *
+ * v7 turns the palette into a real jump-to: it searches patients, prescriptions,
+ * invoices, medicines, lab/imaging orders and staff through /api/hms/search,
+ * keeps the last eight places you went, and offers the handful of actions a
+ * clinician actually performs in a hurry. Everything is keyboard-drivable:
+ * ↑ ↓ to move, Enter to open, Esc to leave, ⌘K to come back.
+ */
+
+type Hit = { id: string; title: string; subtitle?: string; kind: string; href: string; meta?: string };
+type Group = { key: string; items: Hit[] };
+type Row = { id: string; title: string; subtitle?: string; href: string; kind: string; meta?: string; icon?: typeof Users };
+
+const ICONS: Record<string, typeof Users> = {
+  patient: Users,
+  prescription: Pill,
+  invoice: CreditCard,
+  medicine: Beaker,
+  lab: FlaskConical,
+  imaging: ScanLine,
+  staff: Stethoscope,
+  page: LayoutDashboard,
+  action: Sparkles,
+  ask: Sparkles,
+};
+
+const GROUP_LABEL: Record<string, [string, string]> = {
+  actions: ["Quick actions", "کارهای سریع"],
+  ask: ["Ask Aybek", "از ایبک بپرسید"],
+  patients: ["Patients", "بیماران"],
+  prescriptions: ["Prescriptions", "نسخه‌ها"],
+  invoices: ["Invoices", "بل‌ها"],
+  medicines: ["Medicines", "دواها"],
+  orders: ["Lab & imaging", "لابراتوار و اکسری"],
+  staff: ["Staff", "کارمندان"],
+  pages: ["Pages", "صفحه‌ها"],
+  recent: ["Recent", "اخیر"],
+};
+
+const RECENT_KEY = "aybek:recent";
+
+type Recent = { title: string; href: string; kind: string };
+
+export function CommandPalette({ onClose }: { onClose: () => void }) {
+  const router = useRouter();
+  const { tx, t } = useLang();
+  const [q, setQ] = useState("");
+  const [groups, setGroups] = useState<Group[]>([]);
+  const [loading, setLoading] = useState(false);
+  const [cursor, setCursor] = useState(0);
+  const [recent, setRecent] = useState<Recent[]>([]);
+  const inputRef = useRef<HTMLInputElement>(null);
+  const listRef = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    inputRef.current?.focus();
+    try {
+      const raw = localStorage.getItem(RECENT_KEY);
+      if (raw) setRecent((JSON.parse(raw) as Recent[]).slice(0, 6));
+    } catch {
+      /* private mode */
+    }
+  }, []);
+
+  /* ------------------------------------------------------------ live search */
+  useEffect(() => {
+    const term = q.trim();
+    if (term.length < 2) {
+      setGroups([]);
+      setLoading(false);
+      return;
+    }
+    setLoading(true);
+    const timer = setTimeout(async () => {
+      try {
+        const res = await fetch(`/api/hms/search?q=${encodeURIComponent(term)}`);
+        const data = await res.json();
+        setGroups(data.groups ?? []);
+      } catch {
+        setGroups([]);
+      } finally {
+        setLoading(false);
+      }
+    }, 160);
+    return () => clearTimeout(timer);
+  }, [q]);
+
+  const go = useCallback(
+    (href: string, title: string, kind: string) => {
+      try {
+        const next = [{ title, href, kind }, ...recent.filter((r) => r.href !== href)].slice(0, 8);
+        localStorage.setItem(RECENT_KEY, JSON.stringify(next));
+      } catch {
+        /* ignore */
+      }
+      router.push(href);
+      onClose();
+    },
+    [onClose, recent, router]
+  );
+
+  const actions: Row[] = useMemo(
+    () => [
+      { id: "a-ask", title: tx("Ask Aybek about today", "از ایبک در مورد امروز بپرسید"), subtitle: tx("Revenue, stock, backlog, risk — in plain words", "عاید، موجودی، کارهای عقب‌مانده، خطر — به زبان ساده"), href: "/hms/ask", kind: "ask", icon: Sparkles },
+      { id: "a-patient", title: tx("Register a new patient", "ثبت بیمار جدید"), href: "/hms/patients", kind: "action", icon: UserPlus },
+      { id: "a-opd", title: tx("Open the consultation room", "باز کردن اتاق معاینه"), href: "/hms/opd", kind: "action", icon: Stethoscope },
+      { id: "a-pharmacy", title: tx("Dispense a prescription", "تحویل نسخه"), href: "/hms/pharmacy", kind: "action", icon: Pill },
+      { id: "a-lab", title: tx("Enter a laboratory result", "ثبت نتیجهٔ لابراتوار"), href: "/hms/lab", kind: "action", icon: FlaskConical },
+      { id: "a-bed", title: tx("Admit or discharge a patient", "بستری یا رخصتی بیمار"), href: "/hms/inpatients", kind: "action", icon: HeartPulse },
+      { id: "a-invoice", title: tx("Take a payment", "دریافت پول"), href: "/hms/billing", kind: "action", icon: Wallet },
+      { id: "a-settings", title: tx("Smart settings", "تنظیمات هوشمند"), href: "/hms/settings", kind: "action", icon: Settings },
+      { id: "a-licence", title: tx("Licence and serials", "لایسنس و سریال‌ها"), href: "/hms/activate", kind: "action", icon: KeyRound },
+    ],
+    [tx]
+  );
+
+  /* --------------------------------------------------------------- flatten */
+  const rows: Row[] = useMemo(() => {
+    const term = q.trim().toLowerCase();
+    const out: Row[] = [];
+
+    if (term.length >= 2) {
+      out.push({
+        id: "ask-live",
+        title: tx(`Ask Aybek: “${q.trim()}”`, `از ایبک بپرسید: «${q.trim()}»`),
+        subtitle: tx("Search the hospital's own records for this", "در سوابق خود شفاخانه بگردید"),
+        href: `/hms/ask?q=${encodeURIComponent(q.trim())}`,
+        kind: "ask",
+      });
+      for (const g of groups) {
+        for (const item of g.items) out.push({ ...item, kind: item.kind });
+      }
+    }
+
+    const matchingActions = actions.filter((a) => !term || a.title.toLowerCase().includes(term));
+    if (matchingActions.length) out.push(...matchingActions.slice(0, term ? 3 : 5));
+
+    if (!term && recent.length) {
+      out.push(...recent.map((r) => ({ ...r, id: `r-${r.href}`, subtitle: tx("Recently opened", "اخیراً باز شده") })));
+    }
+    return out;
+  }, [actions, groups, q, recent, tx]);
+
+  useEffect(() => setCursor(0), [q]);
+
+  // Keep the highlighted row in view while arrowing.
+  useEffect(() => {
+    const el = listRef.current?.querySelector<HTMLElement>(`[data-row="${cursor}"]`);
+    el?.scrollIntoView({ block: "nearest" });
+  }, [cursor]);
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if (e.key === "ArrowDown") {
+        e.preventDefault();
+        setCursor((c) => Math.min(rows.length - 1, c + 1));
+      } else if (e.key === "ArrowUp") {
+        e.preventDefault();
+        setCursor((c) => Math.max(0, c - 1));
+      } else if (e.key === "Enter") {
+        const row = rows[cursor];
+        if (row) {
+          e.preventDefault();
+          go(row.href, row.title, row.kind);
+        }
+      } else if (e.key === "Escape") {
+        onClose();
+      }
+    };
+    window.addEventListener("keydown", onKey);
+    return () => window.removeEventListener("keydown", onKey);
+  }, [cursor, go, onClose, rows]);
+
+  /* Group the flat list for display, keeping the flattened index for the cursor. */
+  const rendered = useMemo(() => {
+    const blocks: { label: string; rows: { row: Row; index: number }[] }[] = [];
+    rows.forEach((row, index) => {
+      const keynote = q.trim().length >= 2 && row.kind !== "ask" && row.kind !== "action" ? row.kind : row.kind === "ask" ? "ask" : row.subtitle === tx("Recently opened", "اخیراً باز شده") ? "recent" : "actions";
+      const last = blocks[blocks.length - 1];
+      if (last && last.label === keynote) last.rows.push({ row, index });
+      else blocks.push({ label: keynote, rows: [{ row, index }] });
+    });
+    return blocks;
+  }, [q, rows, tx]);
+
+  return (
+    <div
+      className="fixed inset-0 z-[80] flex items-start justify-center bg-black/45 px-4 pt-[10vh] backdrop-blur-[2px] anim-fade"
+      onClick={onClose}
+      role="dialog"
+      aria-modal="true"
+      aria-label={t("shell.search")}
+    >
+      <div
+        className="w-full max-w-xl overflow-hidden rounded-2xl border shadow-2xl anim-pop"
+        style={{ background: "var(--hms-surface)", borderColor: "var(--hms-border)" }}
+        onClick={(e) => e.stopPropagation()}
+      >
+        <div className="flex items-center gap-2 border-b px-3.5 py-3" style={{ borderColor: "var(--hms-border)" }}>
+          {loading ? <Loader2 size={15} className="animate-spin" style={{ color: "var(--hms-brand)" }} /> : <Search size={15} style={{ color: "var(--hms-faint)" }} />}
+          <input
+            ref={inputRef}
+            value={q}
+            onChange={(e) => setQ(e.target.value)}
+            placeholder={tx("Search patients, RX, invoices, medicines, staff…", "بیمار، نسخه، بل، دوا، کارمند…")}
+            className="w-full bg-transparent text-[0.88rem] outline-none"
+            aria-label={tx("Search the hospital", "جستجو در شفاخانه")}
+          />
+          {q ? (
+            <button onClick={() => setQ("")} aria-label={tx("Clear", "پاک کردن")} className="rounded p-1" style={{ color: "var(--hms-faint)" }}>
+              <X size={13} />
+            </button>
+          ) : (
+            <kbd className="hms-kbd">Esc</kbd>
+          )}
+        </div>
+
+        <div ref={listRef} className="max-h-[58vh] overflow-y-auto p-1.5">
+          {rendered.length === 0 && (
+            <p className="px-3 py-8 text-center text-[0.74rem]" style={{ color: "var(--hms-muted)" }}>
+              {q.trim().length >= 2
+                ? tx(`Nothing matched “${q.trim()}”. Try a name, MRN or invoice number.`, `چیزی برای «${q.trim()}» پیدا نشد. نام، MRN یا شمارهٔ بل را امتحان کنید.`)
+                : tx("Type a name, number or action — or pick one below.", "یک نام، شماره یا کار را بنویسید — یا از پایین انتخاب کنید.")}
+            </p>
+          )}
+
+          {rendered.map((block) => (
+            <div key={`${block.label}-${block.rows[0]?.index}`} className="mb-1">
+              <p className="px-2.5 py-1 text-[0.56rem] font-bold uppercase tracking-[0.12em]" style={{ color: "var(--hms-faint)" }}>
+                {GROUP_LABEL[block.label] ? tx(GROUP_LABEL[block.label][0], GROUP_LABEL[block.label][1]) : block.label}
+              </p>
+              {block.rows.map(({ row, index }) => {
+                const Icon = ICONS[row.kind] ?? ArrowRight;
+                const active = index === cursor;
+                return (
+                  <button
+                    key={`${row.kind}-${row.id}-${index}`}
+                    data-row={index}
+                    onMouseEnter={() => setCursor(index)}
+                    onClick={() => go(row.href, row.title, row.kind)}
+                    className="flex w-full items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-left transition"
+                    style={{
+                      background: active ? "var(--hms-brand-soft)" : "transparent",
+                      color: active ? "var(--hms-brand-ink)" : "var(--hms-text)",
+                    }}
+                  >
+                    <Icon size={14} style={{ color: active ? "var(--hms-brand)" : "var(--hms-faint)", flexShrink: 0 }} />
+                    <span className="min-w-0 flex-1">
+                      <span className="block truncate text-[0.78rem] font-medium">{row.title}</span>
+                      {row.subtitle && (
+                        <span className="block truncate text-[0.62rem]" style={{ color: "var(--hms-faint)" }}>
+                          {row.subtitle}
+                        </span>
+                      )}
+                    </span>
+                    {row.meta && <span className="hidden shrink-0 text-[0.6rem] sm:block" style={{ color: "var(--hms-faint)" }}>{row.meta}</span>}
+                    {active && <ArrowRight size={12} className="rtl-flip shrink-0" style={{ color: "var(--hms-brand)" }} />}
+                  </button>
+                );
+              })}
+            </div>
+          ))}
+        </div>
+
+        <div className="flex flex-wrap items-center gap-2 border-t px-3 py-2 text-[0.6rem]" style={{ borderColor: "var(--hms-border)", color: "var(--hms-faint)" }}>
+          <span className="flex items-center gap-1"><kbd className="hms-kbd">↑</kbd><kbd className="hms-kbd">↓</kbd> {tx("move", "حرکت")}</span>
+          <span className="flex items-center gap-1"><kbd className="hms-kbd">↵</kbd> {tx("open", "باز کن")}</span>
+          <span className="flex items-center gap-1"><kbd className="hms-kbd">Esc</kbd> {tx("close", "بستن")}</span>
+          <span className="ms-auto flex items-center gap-1"><Command size={11} /> K</span>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/components/hms/print-bar.tsx b/components/hms/print-bar.tsx
new file mode 100644
index 0000000..084c7a3
--- /dev/null
+++ b/components/hms/print-bar.tsx
@@ -0,0 +1,64 @@
+"use client";
+
+import { ArrowLeft, Printer } from "lucide-react";
+import { useRouter, useSearchParams } from "next/navigation";
+import { Suspense } from "react";
+import { useTx } from "./lang-provider";
+
+function Bar({
+  no,
+  subtitle,
+  template,
+  templates,
+}: {
+  no: string;
+  subtitle: string;
+  template?: number;
+  templates?: { id: number; name: string }[];
+}) {
+  const router = useRouter();
+  const tx = useTx();
+  const sp = useSearchParams();
+  return (
+    <div className="no-print mx-auto mb-3 flex w-[210mm] max-w-[96vw] flex-wrap items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 shadow-sm">
+      <button onClick={() => router.back()} className="flex items-center gap-1 text-[0.72rem] font-semibold text-slate-600 hover:text-slate-900">
+        <ArrowLeft size={13} /> {tx("Back", "بازگشت")}
+      </button>
+      <div className="min-w-0">
+        <p className="truncate text-[0.74rem] font-semibold text-slate-800">{no}</p>
+        <p className="truncate text-[0.62rem] text-slate-500">{subtitle}</p>
+      </div>
+      {templates && templates.length > 0 && (
+        <select
+          className="ml-auto h-8 rounded-md border border-slate-300 bg-white px-2 text-[0.72rem] text-slate-700"
+          value={template}
+          onChange={(e) => {
+            const next = new URLSearchParams(sp.toString());
+            next.set("template", e.target.value);
+            router.replace(`?${next.toString()}`);
+          }}
+        >
+          {templates.map((t) => (
+            <option key={t.id} value={t.id}>
+              {t.id}. {t.name}
+            </option>
+          ))}
+        </select>
+      )}
+      <button
+        onClick={() => window.print()}
+        className={`${templates && templates.length > 0 ? "" : "ml-auto "}flex h-8 items-center gap-1.5 rounded-md bg-slate-900 px-3 text-[0.72rem] font-semibold text-white hover:bg-slate-800`}
+      >
+        <Printer size={12} /> {tx("Print / save PDF", "چاپ / ذخیرهٔ PDF")}
+      </button>
+    </div>
+  );
+}
+
+export function PrintBar(props: { no: string; subtitle: string; template?: number; templates?: { id: number; name: string }[] }) {
+  return (
+    <Suspense fallback={<div className="h-12" />}>
+      <Bar {...props} />
+    </Suspense>
+  );
+}
diff --git a/components/hms/rx-sheet.tsx b/components/hms/rx-sheet.tsx
new file mode 100644
index 0000000..3936b11
--- /dev/null
+++ b/components/hms/rx-sheet.tsx
@@ -0,0 +1,438 @@
+import type { RxTemplate } from "@/lib/hms/templates";
+import { age, dateShort } from "@/lib/hms/format";
+
+export type RxPatient = {
+  patient_name: string;
+  patient_mrn?: string | null;
+  mrn?: string | null;
+  gender?: string | null;
+  dob?: string | null;
+  phone?: string | null;
+  allergies?: string | null;
+  address?: string | null;
+};
+
+export type RxItem = {
+  id?: string;
+  drug: string;
+  strength?: string | null;
+  form?: string | null;
+  dosage?: string | null;
+  frequency?: string | null;
+  duration?: string | null;
+  instructions?: string | null;
+  qty?: number | null;
+  unit_price?: number | null;
+};
+
+export type RxDoc = {
+  rx_no: string;
+  created_at: string;
+  diagnosis?: string | null;
+  icd10?: string | null;
+  notes?: string | null;
+  follow_up?: string | null;
+  doctor_name?: string | null;
+  doctor_title?: string | null;
+  status?: string | null;
+  signed_at?: string | null;
+};
+
+export type RxIdentity = {
+  name: string;
+  name_short?: string;
+  local?: string;
+  tagline?: string;
+  licence?: string;
+  phone?: string;
+  emergency?: string;
+  email?: string;
+  website?: string;
+  address?: string;
+  city?: string;
+  country?: string;
+  footer?: string;
+};
+
+const FONT: Record<RxTemplate["font"], string> = {
+  sans: "ui-sans-serif, 'Segoe UI', system-ui, sans-serif",
+  serif: "'Georgia', 'Times New Roman', serif",
+  display: "'Trebuchet MS', 'Segoe UI', sans-serif",
+  mono: "'Courier New', ui-monospace, monospace",
+};
+
+function crossSvg(color: string, size = 30) {
+  return (
+    <svg width={size} height={size} viewBox="0 0 40 40" aria-hidden>
+      <rect x="15" y="2" width="10" height="36" rx="2.5" fill={color} />
+      <rect x="2" y="15" width="36" height="10" rx="2.5" fill={color} />
+    </svg>
+  );
+}
+
+function Glyph({ kind, color }: { kind: RxTemplate["rxGlyph"]; color: string }) {
+  if (kind === "cross") return crossSvg(color, 26);
+  if (kind === "script")
+    return (
+      <span style={{ fontFamily: FONT.serif, fontSize: 40, lineHeight: 1, color, fontStyle: "italic" }}>℞</span>
+    );
+  if (kind === "outline")
+    return (
+      <span
+        style={{
+          display: "inline-flex", alignItems: "center", justifyContent: "center", width: 34, height: 34,
+          borderRadius: "50%", border: `1.6px solid ${color}`, color, fontSize: 19, fontFamily: FONT.serif, lineHeight: 1,
+        }}
+      >
+        ℞
+      </span>
+    );
+  if (kind === "badge")
+    return (
+      <span
+        style={{
+          display: "inline-flex", alignItems: "center", justifyContent: "center", width: 38, height: 30,
+          borderRadius: 6, background: color, color: "#fff", fontSize: 13, fontWeight: 700, letterSpacing: 0.5,
+        }}
+      >
+        Rx
+      </span>
+    );
+  return (
+    <svg width={30} height={30} viewBox="0 0 40 40" aria-hidden>
+      <path d="M12 8c0 9 4 12 8 14s8 5 8 10" stroke={color} strokeWidth="2.6" fill="none" strokeLinecap="round" />
+      <circle cx="12" cy="8" r="4" stroke={color} strokeWidth="2.4" fill="none" />
+      <circle cx="28" cy="32" r="4" stroke={color} strokeWidth="2.4" fill="none" />
+    </svg>
+  );
+}
+
+function Ornament({ kind, t }: { kind: RxTemplate["ornaments"]; t: RxTemplate }) {
+  const base = { position: "absolute" as const, inset: 0, pointerEvents: "none" as const, overflow: "hidden" };
+  if (kind === "none") return null;
+  if (kind === "rule")
+    return (
+      <div style={base}>
+        <div style={{ position: "absolute", left: 0, right: 0, top: 0, height: 7, background: t.accent }} />
+        <div style={{ position: "absolute", left: 0, right: 0, top: 7, height: 2, background: t.rule }} />
+        <div style={{ position: "absolute", left: 0, right: 0, bottom: 0, height: 3, background: t.accent, opacity: 0.8 }} />
+      </div>
+    );
+  if (kind === "fret")
+    return (
+      <div style={base}>
+        {[0, 1, 2].map((i) => (
+          <div key={i} style={{ position: "absolute", left: 8 + i * 4, right: 8 + i * 4, top: 8 + i * 4, bottom: 8 + i * 4, border: `1px solid ${t.rule}`, opacity: i === 0 ? 0.9 : 0.45 }} />
+        ))}
+        <div style={{ position: "absolute", inset: 0, borderTop: `10px solid ${t.accent}`, borderBottom: `10px solid ${t.accent}`, opacity: 0.09 }} />
+        <div style={{ position: "absolute", top: 22, left: 26, width: 44, height: 44, borderTop: `2px solid ${t.accent}`, borderLeft: `2px solid ${t.accent}` }} />
+        <div style={{ position: "absolute", bottom: 22, right: 26, width: 44, height: 44, borderBottom: `2px solid ${t.accent}`, borderRight: `2px solid ${t.accent}` }} />
+      </div>
+    );
+  if (kind === "blobs")
+    return (
+      <div style={base}>
+        <div style={{ position: "absolute", top: -70, right: -60, width: 260, height: 260, borderRadius: "50%", background: t.accentSoft, opacity: 0.85 }} />
+        <div style={{ position: "absolute", top: -20, right: 90, width: 90, height: 90, borderRadius: "50%", background: t.accent, opacity: 0.1 }} />
+        <div style={{ position: "absolute", bottom: -90, left: -70, width: 240, height: 240, borderRadius: "50%", background: t.accentSoft, opacity: 0.6 }} />
+      </div>
+    );
+  if (kind === "dashed")
+    return (
+      <div style={base}>
+        <div style={{ position: "absolute", inset: 14, border: `1.5px dashed ${t.rule}` }} />
+        <div style={{ position: "absolute", left: 0, right: 0, bottom: 0, height: 26, background: t.accentSoft }} />
+      </div>
+    );
+  if (kind === "paws")
+    return (
+      <div style={base}>
+        <div style={{ position: "absolute", top: -40, right: -30, width: 190, height: 190, borderRadius: "50%", background: t.accentSoft, opacity: 0.7 }} />
+        {[0, 1, 2].map((i) => (
+          <div key={i} style={{ position: "absolute", right: 40 + i * 26, top: 46 + (i % 2) * 16, width: 11, height: 11, borderRadius: "50%", background: t.accent, opacity: 0.18 }} />
+        ))}
+        <div style={{ position: "absolute", bottom: 0, left: 0, right: 0, height: 5, background: `repeating-linear-gradient(90deg, ${t.accent} 0 14px, transparent 14px 28px)`, opacity: 0.35 }} />
+      </div>
+    );
+  if (kind === "arcs")
+    return (
+      <div style={base}>
+        <div style={{ position: "absolute", top: -180, left: "50%", transform: "translateX(-50%)", width: 620, height: 340, borderRadius: "50%", border: `26px solid ${t.accent}`, opacity: 0.07 }} />
+        <div style={{ position: "absolute", top: -140, left: "50%", transform: "translateX(-50%)", width: 480, height: 280, borderRadius: "50%", border: `2px solid ${t.rule}`, opacity: 0.5 }} />
+      </div>
+    );
+  // mosaic
+  return (
+    <div style={base}>
+      <div
+        style={{
+          position: "absolute", top: 0, right: 0, width: 180, height: 120, opacity: 0.14,
+          background: `repeating-linear-gradient(45deg, ${t.accent} 0 10px, transparent 10px 20px)`,
+        }}
+      />
+      <div
+        style={{
+          position: "absolute", bottom: 0, left: 0, width: 150, height: 90, opacity: 0.1,
+          background: `repeating-linear-gradient(-45deg, ${t.accent} 0 8px, transparent 8px 18px)`,
+        }}
+      />
+    </div>
+  );
+}
+
+/**
+ * Bilingual labels for the sheet a patient actually carries home.
+ *
+ * The document follows the reader's language: in Dari the whole sheet flips to
+ * right-to-left and every fixed label is translated, while the medicine names,
+ * the doctor's name and the hospital identity stay exactly as they were entered.
+ */
+const LABELS = {
+  en: {
+    patient: "Patient", mrn: "MRN", ageSex: "Age / Sex", date: "Date",
+    diagnosis: "Diagnosis", allergies: "Allergies",
+    colNo: "#", colDrug: "Medicine", colDose: "Dose & route", colFreq: "Frequency", colDur: "Duration", colQty: "Qty",
+    advice: "Advice & notes", followUp: "Follow-up",
+    defaultAdvice: "Take medicines exactly as prescribed. Complete the full course even if you feel better. Return immediately if you develop fever above 38.5 °C, uncontrolled pain, bleeding or shortness of breath.",
+    seal: "Sealed document", auth: "Electronic authorisation", status: "Status",
+    physician: "Attending physician", signedOn: "Signed", onFile: "Signature on file",
+    page: "page 1 of 1",
+  },
+  fa: {
+    patient: "بیمار", mrn: "شمارهٔ پرونده", ageSex: "سن / جنس", date: "تاریخ",
+    diagnosis: "تشخیص", allergies: "حساسیت",
+    colNo: "شماره", colDrug: "دوا", colDose: "دوز و راه", colFreq: "دفعات", colDur: "مدت", colQty: "تعداد",
+    advice: "توصیه و یادداشت", followUp: "مراجعهٔ بعدی",
+    defaultAdvice: "دواها را دقیقاً مطابق نسخه مصرف کنید. دورهٔ کامل را تمام کنید، حتی اگر بهتر شدید. اگر تب بالای ۳۸٫۵ درجه، درد کنترل‌نشده، خون‌ریزی یا تنگی نفس پیدا کردید فوراً برگردید.",
+    seal: "سند مهر‌شده", auth: "اجازهٔ الکترونیکی", status: "وضعیت",
+    physician: "داکتر معالج", signedOn: "امضا در", onFile: "امضا در پرونده",
+    page: "صفحهٔ ۱ از ۱",
+  },
+} as const;
+
+export function RxSheet({
+  template: t,
+  identity,
+  doc,
+  patient,
+  items,
+  scale = 1,
+  lang = "en",
+}: {
+  template: RxTemplate;
+  identity: RxIdentity;
+  doc: RxDoc;
+  patient: RxPatient;
+  items: RxItem[];
+  scale?: number;
+  lang?: "en" | "fa";
+}) {
+  const L = LABELS[lang];
+  const rtl = lang === "fa";
+  const tableBorder = t.tableStyle === "grid" || t.tableStyle === "hairline" ? `1px solid ${t.rule}` : "none";
+  const headBg =
+    t.tableStyle === "soft" ? t.accentSoft : t.tableStyle === "banded" ? t.accent : t.tableStyle === "pill" ? "transparent" : "transparent";
+  const headColor = t.tableStyle === "banded" ? "#fff" : t.ink;
+
+  return (
+    <div
+      className="rx-sheet"
+      dir={rtl ? "rtl" : "ltr"}
+      style={{
+        background: t.paper,
+        color: t.ink,
+        fontFamily: rtl ? "'Vazirmatn', 'IRANSansX', 'Segoe UI', Tahoma, sans-serif" : FONT[t.font],
+        transform: scale !== 1 ? `scale(${scale})` : undefined,
+        transformOrigin: "top left",
+        boxShadow: "0 18px 60px -28px rgba(15,23,42,0.45)",
+      }}
+    >
+      <Ornament kind={t.ornaments} t={t} />
+
+      <div style={{ position: "relative", padding: "16mm 15mm 12mm", display: "flex", flexDirection: "column", minHeight: "297mm", boxSizing: "border-box" }}>
+        {/* ---------------------------------------------------------- header */}
+        <header style={{ display: "flex", alignItems: "flex-start", gap: 14, borderBottom: `2px solid ${t.accent}`, paddingBottom: 10 }}>
+          <div style={{ display: "flex", alignItems: "center", justifyContent: "center", width: 54, height: 54, borderRadius: t.ornaments === "fret" ? 0 : 12, border: `1.5px solid ${t.accent}`, background: "rgba(255,255,255,0.5)" }}>
+            <Glyph kind={t.rxGlyph} color={t.accent} />
+          </div>
+          <div style={{ flex: 1, minWidth: 0 }}>
+            <h1
+              style={{
+                margin: 0,
+                fontSize: 19,
+                letterSpacing: t.headerCase === "upper" ? 1.4 : 0.1,
+                textTransform: t.headerCase === "upper" ? "uppercase" : "none",
+                lineHeight: 1.15,
+                fontWeight: t.font === "serif" ? 600 : 700,
+              }}
+            >
+              {identity.name}
+            </h1>
+            <p style={{ margin: "3px 0 0", fontSize: 9.5, letterSpacing: 0.2, opacity: 0.75, textTransform: "uppercase" }}>
+              {identity.tagline}
+            </p>
+            <p style={{ margin: "2px 0 0", fontSize: 9, opacity: 0.62 }}>
+              {identity.address} · {identity.city}, {identity.country}
+            </p>
+          </div>
+          <div style={{ textAlign: "right", fontSize: 8.6, lineHeight: 1.65, opacity: 0.8, minWidth: 128 }}>
+            <div style={{ fontWeight: 700, letterSpacing: 0.6, textTransform: "uppercase", fontSize: 7.6, color: t.accent }}>
+              {t.name}
+            </div>
+            <div>{identity.phone}</div>
+            <div>{rtl ? "اضطراری" : "Emergency"} {identity.emergency}</div>
+            <div>{identity.website}</div>
+            <div>{rtl ? "لایسنس" : "Licence"} {identity.licence}</div>
+          </div>
+        </header>
+
+        {/* ------------------------------------------------------- patient bar */}
+        <div
+          style={{
+            display: "grid", gridTemplateColumns: "2fr 1fr 1fr 1fr", gap: 8, marginTop: 12,
+            padding: "9px 11px", borderRadius: t.ornaments === "fret" ? 0 : 8,
+            background: t.ornaments === "fret" || t.ornaments === "mosaic" ? "transparent" : "rgba(255,255,255,0.72)",
+            border: `1px solid ${t.rule}`,
+          }}
+        >
+          {[
+            { k: L.patient, v: patient.patient_name },
+            { k: L.mrn, v: patient.patient_mrn ?? patient.mrn ?? "—" },
+            { k: L.ageSex, v: `${age(patient.dob)} · ${patient.gender ?? "—"}` },
+            { k: L.date, v: dateShort(doc.created_at) },
+          ].map((f) => (
+            <div key={f.k} style={{ minWidth: 0 }}>
+              <div style={{ fontSize: 7.2, letterSpacing: 0.9, textTransform: "uppercase", opacity: 0.55 }}>{f.k}</div>
+              <div style={{ fontSize: 10.5, fontWeight: 600, whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}>{f.v}</div>
+            </div>
+          ))}
+        </div>
+
+        {(patient.allergies || doc.diagnosis) && (
+          <div style={{ display: "flex", gap: 8, marginTop: 7, fontSize: 9 }}>
+            {doc.diagnosis && (
+              <div style={{ flex: 1, padding: "6px 9px", borderRadius: 6, background: t.accentSoft, borderLeft: `3px solid ${t.accent}` }}>
+                <b style={{ letterSpacing: 0.5, textTransform: "uppercase", fontSize: 7.4, opacity: 0.7 }}>{L.diagnosis}</b>
+                <div style={{ fontWeight: 600, fontSize: 10 }}>{doc.diagnosis}{doc.icd10 ? ` (${doc.icd10})` : ""}</div>
+              </div>
+            )}
+            {patient.allergies && (
+              <div style={{ minWidth: 150, padding: "6px 9px", borderRadius: 6, border: "1px solid #e6b3ab", background: "#fdf3f1" }}>
+                <b style={{ letterSpacing: 0.5, textTransform: "uppercase", fontSize: 7.4, color: "#a33a2b" }}>{L.allergies}</b>
+                <div style={{ fontWeight: 600, fontSize: 9.4, color: "#8c2f22" }}>{patient.allergies}</div>
+              </div>
+            )}
+          </div>
+        )}
+
+        {/* ------------------------------------------------------------- Rx ℞ */}
+        <div style={{ display: "flex", alignItems: "center", gap: 9, marginTop: 14, marginBottom: 6 }}>
+          <span style={{ fontFamily: FONT.serif, fontSize: 30, lineHeight: 0.9, color: t.accent, fontStyle: t.font === "serif" ? "normal" : "italic" }}>℞</span>
+          <div style={{ flex: 1, height: 1, background: t.rule }} />
+          <span style={{ fontSize: 8.2, letterSpacing: 0.9, textTransform: "uppercase", opacity: 0.6 }}>{doc.rx_no}</span>
+        </div>
+
+        {/* ----------------------------------------------------------- table */}
+        <table style={{ width: "100%", borderCollapse: "collapse", marginTop: 2 }}>
+          <thead>
+            <tr style={{ background: headBg, color: headColor }}>
+              {[L.colNo, L.colDrug, L.colDose, L.colFreq, L.colDur, L.colQty].map((h, i) => (
+                <th
+                  key={h}
+                  style={{
+                    textAlign: i === 0 ? "center" : "left",
+                    padding: "6px 7px",
+                    fontSize: 7.6,
+                    letterSpacing: 0.8,
+                    textTransform: "uppercase",
+                    border: tableBorder,
+                    borderColor: t.rule,
+                    fontWeight: 700,
+                    width: i === 0 ? 22 : i === 1 ? "34%" : undefined,
+                    borderRadius: t.tableStyle === "pill" ? 999 : 0,
+                  }}
+                >
+                  {h}
+                </th>
+              ))}
+            </tr>
+          </thead>
+          <tbody>
+            {items.map((it, i) => (
+              <tr
+                key={it.id ?? i}
+                style={{
+                  background: t.tableStyle === "banded" && i % 2 === 1 ? t.accentSoft : "transparent",
+                  borderBottom: t.tableStyle === "hairline" ? `1px solid ${t.rule}` : "none",
+                }}
+              >
+                <td style={{ padding: "7px 6px", fontSize: 9, textAlign: "center", border: tableBorder, borderColor: t.rule, opacity: 0.6 }}>{i + 1}</td>
+                <td style={{ padding: "7px 7px", fontSize: 10, border: tableBorder, borderColor: t.rule }}>
+                  <div style={{ fontWeight: 650 }}>{it.drug}{it.strength ? ` ${it.strength}` : ""}</div>
+                  <div style={{ fontSize: 8, opacity: 0.62 }}>{[it.form, it.instructions].filter(Boolean).join(" · ") || "—"}</div>
+                </td>
+                <td style={{ padding: "7px 7px", fontSize: 9.2, border: tableBorder, borderColor: t.rule }}>{it.dosage ?? "—"}</td>
