+          </Card>
+        ))}
+      </div>
+
+      <div className="flex items-center justify-center gap-2 pb-2 text-[0.62rem] text-faint">
+        <Sparkles size={11} /> Forecasts use a seasonal-naive model over 12 weeks of booking history.
+      </div>
+    </div>
+  );
+}
