+import { Sidebar } from "./sidebar";
+import { Topbar } from "./topbar";
+
+export function AppShell({
+  user,
+  counts,
+  children,
+}: {
+  user: SessionUser;
+  counts: { pending: number; waitlist: number; unread: number };
