# Angular specific
/dist/
/out-tsc/
/tmp/
/coverage/
/e2e/test-output/
/.angular/
.angular/

# Node modules and dependency files
/node_modules/
/package-lock.json
/yarn.lock

# Environment files
/.env

# Angular CLI and build artefacts
/.angular-cli.json
/.ng/

# TypeScript cache
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local Python audit dependencies and generated bytecode
.cache/
.venv/
__pycache__/
*.py[cod]

# Hospital runtime data, exports and local secrets (never commit patient data)
.data/
backups/
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
.env.*
!.env.example

# Reproducible frontend test tooling
!/package-lock.json

# Never ship issuer private keys or local activation secrets
*.pem
*.key
.ash-install-state.json

# Enterprise runtime secrets, import inputs and PostgreSQL exports
.secrets/
imports/
*.dump
*.pgpass
